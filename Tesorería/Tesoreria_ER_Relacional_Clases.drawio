        <mxCell id="p2c105" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=#666666;fillColor=#ffffff;spacing=12;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Notación textual&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TIPO_CUOTA&lt;/b&gt; (&lt;u&gt;id_tipo_cuota&lt;/u&gt;, nombre, importe, periodicidad, activo)&lt;br&gt;&lt;b&gt;CUOTA&lt;/b&gt; (&lt;u&gt;id_cuota&lt;/u&gt;, referencia, ejercicio, importe, fecha_emision, fecha_vencimiento, estado, &lt;i&gt;id_socio&lt;/i&gt;*, &lt;i&gt;id_tipo_cuota&lt;/i&gt;*, &lt;i&gt;id_factura&lt;/i&gt;*)&lt;br&gt;&lt;b&gt;PAGO&lt;/b&gt; (&lt;u&gt;id_pago&lt;/u&gt;, fecha, importe, referencia, estado, &lt;i&gt;id_metodo&lt;/i&gt;*, &lt;i&gt;id_cuota&lt;/i&gt;*, &lt;i&gt;id_liquidacion&lt;/i&gt;*)&lt;br&gt;&lt;b&gt;METODO_PAGO&lt;/b&gt; (&lt;u&gt;id_metodo&lt;/u&gt;, nombre, tipo)&lt;br&gt;&lt;b&gt;LIQUIDACION&lt;/b&gt; (&lt;u&gt;id_liquidacion&lt;/u&gt;, fecha, fecha_desde, fecha_hasta, estado, &lt;i&gt;id_cuenta&lt;/i&gt;*, &lt;i&gt;id_factura&lt;/i&gt;*)&lt;br&gt;&lt;b&gt;CUENTA_SOCIO&lt;/b&gt; (&lt;u&gt;id_cuenta&lt;/u&gt;, limite_credito, estado, &lt;i&gt;id_socio&lt;/i&gt;*)&lt;br&gt;&lt;b&gt;CARGO_FACIAL&lt;/b&gt; (&lt;u&gt;id_cargo&lt;/u&gt;, fecha_hora, importe, confianza, estado, &lt;i&gt;id_cuenta&lt;/i&gt;*, &lt;i&gt;id_ticket&lt;/i&gt;*, &lt;i&gt;id_liquidacion&lt;/i&gt;*)&lt;br&gt;&lt;b&gt;PRESUPUESTO&lt;/b&gt; (&lt;u&gt;id_presupuesto&lt;/u&gt;, nombre, ejercicio, fecha_inicio, fecha_fin, estado)&lt;br&gt;&lt;b&gt;LINEA_PRESUPUESTO&lt;/b&gt; (&lt;u&gt;id_linea&lt;/u&gt;, concepto, tipo, importe_previsto, &lt;i&gt;id_presupuesto&lt;/i&gt;*)&lt;br&gt;&lt;b&gt;GASTO&lt;/b&gt; (&lt;u&gt;id_gasto&lt;/u&gt;, descripcion, fecha, importe, estado, &lt;i&gt;id_linea&lt;/i&gt;*, &lt;i&gt;id_empleado&lt;/i&gt;*)&lt;br&gt;&lt;br&gt;&lt;b&gt;Claves ajenas (*)&lt;/b&gt;&lt;br&gt;CUOTA.id_socio → SOCIO&lt;br&gt;CUOTA.id_tipo_cuota → TIPO_CUOTA&lt;br&gt;CUOTA.id_factura → FACTURA (puede ser nula) · única&lt;br&gt;PAGO.id_metodo → METODO_PAGO&lt;br&gt;PAGO.id_cuota → CUOTA (puede ser nula)&lt;br&gt;PAGO.id_liquidacion → LIQUIDACION (puede ser nula)&lt;br&gt;CUENTA_SOCIO.id_socio → SOCIO · única&lt;br&gt;CARGO_FACIAL.id_cuenta → CUENTA_SOCIO&lt;br&gt;CARGO_FACIAL.id_ticket → TICKET · única&lt;br&gt;CARGO_FACIAL.id_liquidacion → LIQUIDACION (puede ser nula)&lt;br&gt;LIQUIDACION.id_cuenta → CUENTA_SOCIO&lt;br&gt;LIQUIDACION.id_factura → FACTURA (puede ser nula) · única&lt;br&gt;LINEA_PRESUPUESTO.id_presupuesto → PRESUPUESTO&lt;br&gt;GASTO.id_linea → LINEA_PRESUPUESTO (puede ser nula)&lt;br&gt;GASTO.id_empleado → EMPLEADO&lt;br&gt;&lt;br&gt;&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;· &lt;u&gt;Subrayado&lt;/u&gt;: clave primaria; &lt;i&gt;cursiva&lt;/i&gt;*: clave ajena.&lt;br&gt;· Las relaciones 1:1 (cuota–factura, liquidación–factura, cargo–ticket, socio–cuenta) se implementan con clave ajena UNIQUE.&lt;br&gt;· Los atributos derivados (saldo, importe_total, total_previsto, importe_real) no se almacenan: en Odoo son campos computados.&lt;br&gt;· Las tablas en gris pertenecen a otros grupos; entre corchetes, nombre de la tabla en Odoo." vertex="1">
          <mxGeometry height="600" width="900" x="1560" y="420" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
