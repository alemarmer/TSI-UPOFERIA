<odoo>
  <record id="upoferia_elemento_seguridad_form_view" model="ir.ui.view">
    <field name="name">upoferia.elemento_seguridad.form</field>
    <field name="model">upoferia.elemento_seguridad</field>
    <field name="arch" type="xml">
      <form string="Elementos de seguridad">
        <sheet layout="auto">
          <widget name="web_ribbon" title="Revisión vencida" bg_color="text-bg-danger" invisible="not bRevisionVencida" />
          <group>
            <group string="Mobiliario">
              <field name="sNumeroSerie" placeholder="Ej. EXT-2026-0001" />
              <field name="sNombre" />
              <field name="caseta_id" />
              <field name="dFechaAsignacion" invisible="not caseta_id" required="caseta_id" />
              <field name="fCoste" />
            </group>
            <group string="Seguridad">
              <field name="sTipo" />
              <field name="dFechaUltimaRevision" />
              <field name="dFechaProximaRevision" />
              <field name="bRevisionVencida" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_elemento_seguridad_list_view" model="ir.ui.view">
    <field name="name">upoferia.elemento_seguridad.list</field>
    <field name="model">upoferia.elemento_seguridad</field>
    <field name="arch" type="xml">
      <list string="Elementos de seguridad" decoration-danger="bRevisionVencida">
        <field name="sNumeroSerie" />
        <field name="sNombre" />
        <field name="sTipo" />
        <field name="caseta_id" />
        <field name="dFechaUltimaRevision" />
        <field name="dFechaProximaRevision" />
        <field name="bRevisionVencida" />
      </list>
    </field>
  </record>

  <record id="upoferia_elemento_seguridad_graph_view" model="ir.ui.view">
    <field name="name">upoferia.elemento_seguridad.graph</field>
    <field name="model">upoferia.elemento_seguridad</field>
    <field name="arch" type="xml">
      <graph string="Elementos por tipo y mes de la próxima revisión" type="bar">
        <field name="sTipo" />
        <field name="dFechaProximaRevision" interval="month" />
      </graph>
    </field>
  </record>

  <record id="elemento_seguridad_list_action" model="ir.actions.act_window">
    <field name="name">Elementos de seguridad</field>
    <field name="res_model">upoferia.elemento_seguridad</field>
    <field name="view_mode">list,form,graph</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer elemento de seguridad</p>
    </field>
  </record>
</odoo>
