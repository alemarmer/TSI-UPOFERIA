<odoo>
  <record id="upoferia_proveedor_form_view" model="ir.ui.view">
    <field name="name">upoferia.proveedor.form</field>
    <field name="model">upoferia.proveedor</field>
    <field name="arch" type="xml">
      <form string="Proveedor">
        <header>
          <button name="btn_eliminarTarifas" string="Eliminar tarifas" type="object" invisible="not servicio_proveedor_ids" />
        </header>
        <sheet layout="auto">
          <group>
            <field name="sCif" />
            <field name="categoria_ids" widget="many2many_tags" options="{'color_field': 'iColor'}" />
          </group>
          <notebook>
            <page name="servicios" string="Servicios que ofrece">
              <field name="servicio_proveedor_ids">
                <list editable="bottom">
                  <field name="servicio_id" />
                  <field name="fPrecioTarifa" />
                </list>
              </field>
            </page>
            <page name="marcas" string="Marcas">
              <field name="marca_ids" readonly="1">
                <list>
                  <field name="sNombre" />
                  <field name="sColorCorporativo" widget="color" />
                </list>
              </field>
            </page>
            <page name="transacciones" string="Transacciones">
              <field name="transaccion_ids" readonly="1">
                <list>
                  <field name="sIdTransaccion" />
                  <field name="tipo_transaccion_id" />
                  <field name="dFechaInicial" />
                  <field name="fImporte" />
                  <field name="sEstado" widget="badge" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_proveedor_list_view" model="ir.ui.view">
    <field name="name">upoferia.proveedor.list</field>
    <field name="model">upoferia.proveedor</field>
    <field name="arch" type="xml">
      <list string="Proveedores">
        <field name="sCif" />
        <field name="categoria_ids" widget="many2many_tags" options="{'color_field': 'iColor'}" />
      </list>
    </field>
  </record>

  <record id="proveedor_list_action" model="ir.actions.act_window">
    <field name="name">Proveedores</field>
    <field name="res_model">upoferia.proveedor</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer proveedor</p>
    </field>
  </record>
</odoo>
