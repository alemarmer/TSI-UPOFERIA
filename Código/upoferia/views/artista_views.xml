<odoo>

  <record id="upoferia_artista_list_view" model="ir.ui.view">
    <field name="name">upoferia.artista.list</field>
    <field name="model">upoferia.artista</field>
    <field name="arch" type="xml">
      <list string="Artistas">
        <field name="sDni"/>
        <field name="fCache_base"/>
      </list>
    </field>
  </record>

  <record id="upoferia_artista_form_view" model="ir.ui.view">
    <field name="name">upoferia.artista.form</field>
    <field name="model">upoferia.artista</field>
    <field name="arch" type="xml">
      <form string="Artista">
        <sheet>
          <group>
            <group>
              <field name="sDni"/>
              <field name="fCache_base"/>
            </group>
            <group string="Necesidades técnicas">
              <field name="sMontaje"/>
              <field name="bIluminacion"/>
              <field name="fPotencia_kw"/>
              <field name="sSonido"/>
              <field name="sEspacio"/>
            </group>
          </group>
          <notebook>
            <page name="disciplinas" string="Disciplinas">
              <field name="disciplina_ids">
                <list editable="bottom">
                  <field name="sDisciplina"/>
                </list>
              </field>
            </page>
            <page name="actuaciones" string="Actuaciones">
              <field name="actuacion_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_artista_action" model="ir.actions.act_window">
    <field name="name">Artistas</field>
    <field name="res_model">upoferia.artista</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Registra el primer artista</p>
    </field>
  </record>

</odoo>
