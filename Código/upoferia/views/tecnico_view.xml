<odoo>
  <record id="upoferia_tecnico_form_view" model="ir.ui.view">
    <field name="name">upoferia.tecnico.form</field>
    <field name="model">upoferia.tecnico</field>
    <field name="arch" type="xml">
      <form string="Técnicos">
        <header>
          <button name="btn_quitarExhibiciones" string="Quitar exhibiciones" type="object" />
        </header>
        <sheet layout="auto">
          <group>
            <field name="persona_id" />
            <field name="sEspecialidad" />
            <field name="sCodCarnetProfesional" />
            <field name="dFechaCaducidadCarnet" />
          </group>
          <notebook>
            <page name="exhibiciones" string="Exhibiciones">
              <field name="exhibicion_ids" readonly="1" />
            </page>
            <page name="mantenimientos" string="Mantenimientos">
              <field name="mantenimiento_ids" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_tecnico_list_view" model="ir.ui.view">
    <field name="name">upoferia.tecnico.list</field>
    <field name="model">upoferia.tecnico</field>
    <field name="arch" type="xml">
      <list string="Técnicos">
        <field name="persona_id" />
        <field name="sEspecialidad" />
        <field name="sCodCarnetProfesional" />
        <field name="dFechaCaducidadCarnet" />
      </list>
    </field>
  </record>

  <record id="upoferia_tecnico_calendar_view" model="ir.ui.view">
    <field name="name">upoferia.tecnico.calendar</field>
    <field name="model">upoferia.tecnico</field>
    <field name="arch" type="xml">
      <calendar string="Caducidad de carnés" color="sEspecialidad" date_start="dFechaCaducidadCarnet" mode="month">
        <field name="sNombre" />
        <field name="sCodCarnetProfesional" />
      </calendar>
    </field>
  </record>

  <record id="tecnico_list_action" model="ir.actions.act_window">
    <field name="name">Técnicos</field>
    <field name="res_model">upoferia.tecnico</field>
    <field name="view_mode">list,form,calendar</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer técnico</p>
    </field>
  </record>
</odoo>