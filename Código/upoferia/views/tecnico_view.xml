<odoo>
  <record id="upoferia_tecnico_form_view" model="ir.ui.view">
    <field name="name">upoferia.tecnico.form</field>
    <field name="model">upoferia.tecnico</field>
    <field name="arch" type="xml">
      <form string="Técnico">
        <sheet layout="auto">
          <group>
            <group>
              <field name="sEspecialidad" />
            </group>
            <group string="Carné profesional">
              <field name="sCodCarnetProfesional" />
              <field name="dFechaCaducidadCarnet" />
            </group>
          </group>
          <notebook>
            <page name="exhibiciones" string="Exhibiciones">
              <field name="exhibicion_ids" readonly="1">
                <list>
                  <field name="sIdExhibicion" />
                  <field name="marca_id" />
                  <field name="espacio_publicitario_id" />
                  <field name="dFechaMontaje" />
                  <field name="sEstadoExhibicion" widget="badge" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_tecnico_list_view" model="ir.ui.view">
    <field name="name">upoferia.tecnico.list</field>
    <field name="model">upoferia.tecnico</field>
    <field name="arch" type="xml">
      <list string="Técnicos">
        <field name="sEspecialidad" />
        <field name="sCodCarnetProfesional" />
        <field name="dFechaCaducidadCarnet" />
      </list>
    </field>
  </record>

  <record id="tecnico_list_action" model="ir.actions.act_window">
    <field name="name">Técnicos</field>
    <field name="res_model">upoferia.tecnico</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer técnico</p>
    </field>
  </record>
</odoo>
