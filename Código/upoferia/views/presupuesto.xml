<odoo>
  <record id="upoferia_presupuesto_form_view" model="ir.ui.view">
    <field name="name">upoferia.presupuesto.form</field>
    <field name="model">upoferia.presupuesto</field>
    <field name="arch" type="xml">
      <form string="Presupuestos">
        <header>
          <field name="selEstado" widget="statusbar" options="{'clickable': '1'}" />
        </header>
        <sheet layout="auto">
          <group>
            <group>
              <field name="sNombre" placeholder="Presupuesto feria 2026" />
              <field name="iEjercicio" />
            </group>
            <group>
              <field name="dFechaInicio" />
              <field name="dFechaFin" />
            </group>
          </group>
          <notebook>
            <page name="lineas" string="Líneas">
              <field name="linea_ids" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_presupuesto_list_view" model="ir.ui.view">
    <field name="name">upoferia.presupuesto.list</field>
    <field name="model">upoferia.presupuesto</field>
    <field name="arch" type="xml">
      <list string="Presupuestos">
        <field name="iEjercicio" />
        <field name="sNombre" />
        <field name="dFechaInicio" />
        <field name="dFechaFin" />
        <field name="selEstado" />
      </list>
    </field>
  </record>

  <record id="upoferia_presupuesto_calendar_view" model="ir.ui.view">
    <field name="name">upoferia.presupuesto.calendar</field>
    <field name="model">upoferia.presupuesto</field>
    <field name="arch" type="xml">
      <calendar string="Presupuestos" date_start="dFechaInicio" date_stop="dFechaFin" mode="year">
        <field name="sNombre" />
        <field name="selEstado" />
      </calendar>
    </field>
  </record>

  <record id="upoferia_presupuesto_search_view" model="ir.ui.view">
    <field name="name">upoferia.presupuesto.search</field>
    <field name="model">upoferia.presupuesto</field>
    <field name="arch" type="xml">
      <search>
        <field name="sNombre" />
        <field name="iEjercicio" />
        <filter name="search_borradores" string="Borradores" domain="[('selEstado','=','borrador')]" />
        <filter name="search_aprobados" string="Aprobados" domain="[('selEstado','=','aprobado')]" />
        <filter name="search_cerrados" string="Cerrados" domain="[('selEstado','=','cerrado')]" />
        <separator orientation="vertical" />
        <group expand="0" string="Agrupar por...">
          <filter name="group_by_ejercicio" string="Ejercicio" context="{'group_by':'iEjercicio'}" />
          <filter name="group_by_estado" string="Estado" context="{'group_by':'selEstado'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="presupuesto_list_action" model="ir.actions.act_window">
    <field name="name">Presupuestos</field>
    <field name="res_model">upoferia.presupuesto</field>
    <field name="search_view_id" ref="upoferia_presupuesto_search_view" />
    <field name="view_mode">list,form,calendar</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer presupuesto</p>
    </field>
  </record>
</odoo>
