<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="presupuesto_view_list" model="ir.ui.view">
        <field name="name">upoferia.presupuesto.list</field>
        <field name="model">upoferia.presupuesto</field>
        <field name="arch" type="xml">
            <list>
                <field name="iEjercicio"/>
                <field name="sNombre"/>
                <field name="dFechaInicio"/>
                <field name="dFechaFin"/>
                <field name="selEstado"/>
            </list>
        </field>
    </record>

    <record id="presupuesto_view_form" model="ir.ui.view">
        <field name="name">upoferia.presupuesto.form</field>
        <field name="model">upoferia.presupuesto</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="selEstado" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sNombre" placeholder="Nombre"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="iEjercicio"/>
                        </group>
                        <group>
                            <field name="dFechaInicio"/>
                            <field name="dFechaFin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="sConcepto"/>
                                    <field name="selTipo"/>
                                    <field name="categoria_economica_id"/>
                                    <field name="fImportePrevisto" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="presupuesto_view_calendar" model="ir.ui.view">
        <field name="name">upoferia.presupuesto.calendar</field>
        <field name="model">upoferia.presupuesto</field>
        <field name="arch" type="xml">
            <calendar string="Presupuestos" date_start="dFechaInicio" date_stop="dFechaFin" mode="year">
                <field name="sNombre"/>
                <field name="selEstado"/>
            </calendar>
        </field>
    </record>

    <record id="presupuesto_list_action" model="ir.actions.act_window">
        <field name="name">Presupuestos</field>
        <field name="res_model">upoferia.presupuesto</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer presupuesto</p>
        </field>
    </record>

    <menuitem name="Presupuestos" id="presupuesto_menu" parent="tesoreria_menu" action="presupuesto_list_action" sequence="30"/>

</odoo>
