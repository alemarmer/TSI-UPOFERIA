<odoo>
  <record id="upoferia_mantenimiento_form_view" model="ir.ui.view">
    <field name="name">upoferia.mantenimiento.form</field>
    <field name="model">upoferia.mantenimiento</field>
    <field name="arch" type="xml">
      <form string="Mantenimientos">
        <header>
          <field name="sEstado" widget="statusbar" options="{'clickable': '1'}" />
        </header>
        <sheet layout="auto">
          <group>
            <field name="sIdMantenimiento" />
            <field name="sAsunto" />
            <field name="sTipoMantenimiento" />
            <field name="incidencia_id" widget="many2one" />
            <field name="dFechaSolicitud" />
            <field name="dFechaProgramada" />
            <field name="fDuracionHoras" widget="float_time" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_mantenimiento_list_view" model="ir.ui.view">
    <field name="name">upoferia.mantenimiento.list</field>
    <field name="model">upoferia.mantenimiento</field>
    <field name="arch" type="xml">
      <list string="Mantenimientos">
        <field name="sIdMantenimiento" />
        <field name="sAsunto" />
        <field name="sTipoMantenimiento" />
        <field name="incidencia_id" widget="many2one" />
        <field name="dFechaSolicitud" />
        <field name="dFechaProgramada" />
        <field name="fDuracionHoras" widget="float_time" />
        <field name="sEstado" />
      </list>
    </field>
  </record>

  <record id="upoferia_mantenimiento_graph_view" model="ir.ui.view">
    <field name="name">upoferia.mantenimiento.graph</field>
    <field name="model">upoferia.mantenimiento</field>
    <field name="arch" type="xml">
      <graph string="Horas de mantenimiento" type="bar">
        <field name="sTipoMantenimiento" />
        <field name="fDuracionHoras" type="measure" />
      </graph>
    </field>
  </record>

  <record id="upoferia_mantenimiento_search_view" model="ir.ui.view">
    <field name="name">upoferia.mantenimiento.search</field>
    <field name="model">upoferia.mantenimiento</field>
    <field name="arch" type="xml">
      <search>
        <field name="sIdMantenimiento" />
        <filter name="search_correctivos" string="Correctivos" domain="[('sTipoMantenimiento','=','correctivo')]" />
        <group expand="0" string="Agrupar por...">
          <filter name="group_by_tipo" string="Tipo" context="{'group_by':'sTipoMantenimiento'}" />
          <filter name="group_by_estado" string="Estado" context="{'group_by':'sEstado'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="mantenimiento_list_action" model="ir.actions.act_window">
    <field name="name">Mantenimientos</field>
    <field name="res_model">upoferia.mantenimiento</field>
    <field name="search_view_id" ref="upoferia_mantenimiento_search_view" />
    <field name="view_mode">list,form,graph</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer mantenimiento</p>
    </field>
  </record>
</odoo>
