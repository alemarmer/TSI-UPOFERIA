<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tipo_cuota_view_list" model="ir.ui.view">
        <field name="name">upoferia.tipo_cuota.list</field>
        <field name="model">upoferia.tipo_cuota</field>
        <field name="arch" type="xml">
            <list>
                <field name="sNombre"/>
                <field name="fImporte"/>
            </list>
        </field>
    </record>

    <record id="tipo_cuota_view_form" model="ir.ui.view">
        <field name="name">upoferia.tipo_cuota.form</field>
        <field name="model">upoferia.tipo_cuota</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sNombre" placeholder="Nombre"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fImporte"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tipo_cuota_view_kanban" model="ir.ui.view">
        <field name="name">upoferia.tipo_cuota.kanban</field>
        <field name="model">upoferia.tipo_cuota</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="sNombre" class="fw-bold fs-5"/>
                        <field name="fImporte"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="tipo_cuota_list_action" model="ir.actions.act_window">
        <field name="name">Tipos de cuota</field>
        <field name="res_model">upoferia.tipo_cuota</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer tipo de cuota</p>
        </field>
    </record>

    <menuitem name="Tipos de cuota" id="tipo_cuota_menu" parent="catalogos_menu" action="tipo_cuota_list_action" sequence="10"/>

</odoo>
