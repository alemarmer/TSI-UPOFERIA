<odoo>
  <record id="upoferia_tipo_cuota_form_view" model="ir.ui.view">
    <field name="name">upoferia.tipo_cuota.form</field>
    <field name="model">upoferia.tipo_cuota</field>
    <field name="arch" type="xml">
      <form string="Tipos de cuota">
        <sheet layout="auto">
          <group>
            <field name="sNombre" placeholder="Cuota anual" />
            <field name="fImporte" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_tipo_cuota_list_view" model="ir.ui.view">
    <field name="name">upoferia.tipo_cuota.list</field>
    <field name="model">upoferia.tipo_cuota</field>
    <field name="arch" type="xml">
      <list string="Tipos de cuota">
        <field name="sNombre" />
        <field name="fImporte" />
      </list>
    </field>
  </record>

  <record id="upoferia_tipo_cuota_kanban_view" model="ir.ui.view">
    <field name="name">upoferia.tipo_cuota.kanban</field>
    <field name="model">upoferia.tipo_cuota</field>
    <field name="arch" type="xml">
      <kanban string="Tipos de cuota">
        <templates>
          <t t-name="card">
            <field name="sNombre" class="fw-bold fs-5" />
            <field name="fImporte" />
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="tipo_cuota_list_action" model="ir.actions.act_window">
    <field name="name">Tipos de cuota</field>
    <field name="res_model">upoferia.tipo_cuota</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer tipo de cuota</p>
    </field>
  </record>
</odoo>
