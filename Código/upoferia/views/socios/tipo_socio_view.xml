<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_socios_tipo_socio_list_view" model="ir.ui.view">
        <field name="name">upoferia.socios.tipo_socio.list</field>
        <field name="model">upoferia.socios.tipo_socio</field>
        <field name="arch" type="xml">
            <list string="Tipo de socio">
                <field name="name"/>
                <field name="multiplicador_xp"/>
                <field name="cuota"/>
                <field name="num_beneficiarios"/>
                <field name="num_invitciones"/>
                <field name="limite_credito"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_socios_tipo_socio_form_view" model="ir.ui.view">
        <field name="name">upoferia.socios.tipo_socio.form</field>
        <field name="model">upoferia.socios.tipo_socio</field>
        <field name="arch" type="xml">
            <form string="Tipo de socio">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="multiplicador_xp"/>
                        <field name="cuota"/>
                        <field name="num_beneficiarios"/>
                        <field name="num_invitciones"/>
                        <field name="limite_credito"/>  
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_socios_tipo_socio_action" model="ir.actions.act_window">
        <field name="name">Tipos de socio</field>
        <field name="res_model">upoferia.socios.tipo_socio</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer tipo de socio
            </p>
        </field>
    </record>
</odoo>