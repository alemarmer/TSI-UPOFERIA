<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_socios_socio_list_view" model="ir.ui.view">
        <field name="name">upoferia.socios.socio.list</field>
        <field name="model">upoferia.socios.socio</field>
        <field name="arch" type="xml">
            <list string="Socio">
                <field name="persona_id"/>
                <field name="tipo_socio_id"/>
                <field name="clan"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_socios_socio_form_view" model="ir.ui.view">
        <field name="name">upoferia.socios.socio.form</field>
        <field name="model">upoferia.socios.socio</field>
        <field name="arch" type="xml">
            <form string="Socio">
                <sheet>
                    <group>
                        <field name="persona_id"/>
                        <field name="tipo_socio_id"/>
                        <field name="clan"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_socios_socio_action" model="ir.actions.act_window">
        <field name="name">Socios</field>
        <field name="res_model">upoferia.socios.socio</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer socio de la caseta
            </p>
        </field>
    </record>
</odoo>