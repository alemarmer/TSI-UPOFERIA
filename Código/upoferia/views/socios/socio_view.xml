<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu temporal para prueba -->
    <menuitem id="menu_root" name="UPO Feria" sequence="1"/>

    <!-- Vista Lista -->
    <record id="upoferia_socios_socio_view_list" model="ir.ui.view">
        <field name="name">upoferia.socios.socio.list</field>
        <field name="model">upoferia.socios.socio</field>
        <field name="arch" type="xml">
            <list string="Socio">
                <field name="dni"/>
                <field name="tipo_socio"/>
                <field name="clan"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_socios_socio_view_form" model="ir.ui.view">
        <field name="name">upoferia.socios.socio.form</field>
        <field name="model">upoferia.socios.socio</field>
        <field name="arch" type="xml">
            <form string="Socio">
                <sheet>
                    <group>
                        <field name="dni"/>
                        <field name="tipo_socio"/>
                        <field name="clan"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_socios_socio_action" model="ir.actions.act_window">
        <field name="name">Socios</field>
        <field name="res_model">upoferia.socios.socio</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer socio de la caseta
            </p>
        </field>
    </record>

    <!-- Menú de Socios -->
    <menuitem id="upoferia_socios_socio_menu"
              name="Socios"
              parent="upoferia.menu_root"
              action="upoferia_socios_socio_action"/>
</odoo>