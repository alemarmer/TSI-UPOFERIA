<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_socios_consentimiento_biometrico_list_view" model="ir.ui.view">
        <field name="name">upoferia.socios.consentimiento_biometrico.list</field>
        <field name="model">upoferia.socios.consentimiento_biometrico</field>
        <field name="arch" type="xml">
            <list string="Consentimiento biometrico">
                <field name="name"/>
                <field name="estado"/>
                <field name="fecha_firma"/>
                <field name="fecha_renovacion"/>
                <field name="datos_biometricos"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_socios_consentimiento_biometrico_form_view" model="ir.ui.view">
        <field name="name">upoferia.socios.consentimiento_biometrico.form</field>
        <field name="model">upoferia.socios.consentimiento_biometrico</field>
        <field name="arch" type="xml">
            <form string="Consentimiento biometrico">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="estado"/>
                        <field name="fecha_firma"/>
                        <field name="fecha_renovacion"/>
                        <field name="datos_biometricos"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_socios_consentimiento_biometrico_action" model="ir.actions.act_window">
        <field name="name">Consentimientos biometricos</field>
        <field name="res_model">upoferia.socios.consentimiento_biometrico</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer consentimiento biometrico
            </p>
        </field>
    </record>
</odoo>