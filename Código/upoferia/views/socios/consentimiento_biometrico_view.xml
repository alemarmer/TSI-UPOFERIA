<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_socios_consentimiento_biometrico_list_view" model="ir.ui.view">
        <field name="name">upoferia.socios.consentimiento_biometrico.list</field>
        <field name="model">upoferia.socios.consentimiento_biometrico</field>
        <field name="arch" type="xml">
            <list string="Consentimiento biometrico">
                <field name="persona_id"/>
                <field name="estado"/>
                <field name="fecha_firma"/>
                <field name="fecha_renovacion"/>
                <field name="datos_biometricos"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_socios_consentimiento_biometrico_form_view" model="ir.ui.view">
        <field name="name">upoferia.socios.consentimiento_biometrico.form</field>
        <field name="model">upoferia.socios.consentimiento_biometrico</field>
        <field name="arch" type="xml">
            <form string="Consentimiento biometrico">
                <sheet>
                    <group>
                        <field name="persona_id"/>
                        <field name="fecha_firma"/>
                        <field name="datos_biometricos"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Calendar -->
    <record id="upoferia_socios_consentimiento_biometrico_calendar_view" model="ir.ui.view">
        <field name="name">upoferia.socios.consentimiento_biometrico.calendar</field>
        <field name="model">upoferia.socios.consentimiento_biometrico</field>
        <field name="arch" type="xml">
            <calendar string="Consentimiento biometrico" date_start="fecha_firma" color="estado">
                <field name="persona_id"/>
                <field name="fecha_renovacion"/>
            </calendar>
        </field>
    </record>

    <!-- Vista kanban -->
    <record id="upoferia_socios_consentimiento_biometrico_kanban_view" model="ir.ui.view">
    <field name="name">upoferia.socios.consentimiento_biometrico.kanban</field>
    <field name="model">upoferia.socios.consentimiento_biometrico</field>
    <field name="arch" type="xml">
        <kanban string="Consentimientos Biométricos" default_group_by="estado" class="o_kanban_small_column">
            <field name="persona_id"/>
            <field name="estado"/>
            <field name="fecha_firma"/>
            <field name="fecha_renovacion"/>
            <field name="datos_biometricos"/>
            
            <templates>
                <t t-name="card">
                    <div class="oe_kanban_card oe_kanban_global_click">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_title font-weight-bold">
                                <strong><field name="persona_id"/></strong>
                            </div>
                            <div class="text-muted small mt-1">
                                <span>Firma: </span><field name="fecha_firma"/>
                            </div>
                            <div class="text-muted small">
                                <span>Renovación: </span><field name="fecha_renovacion"/>
                            </div>
                            <div class="mt-2">
                                <field name="estado" widget="badge"/>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

    <!-- Acción de Ventana -->
    <record id="upoferia_socios_consentimiento_biometrico_action" model="ir.actions.act_window">
        <field name="name">Consentimientos biometricos</field>
        <field name="res_model">upoferia.socios.consentimiento_biometrico</field>
        <field name="view_mode">list,form,calendar,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer consentimiento biometrico
            </p>
        </field>
    </record>
</odoo>