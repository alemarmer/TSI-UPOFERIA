<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_socios_beneficiario_list_view" model="ir.ui.view">
        <field name="name">upoferia.socios.beneficiario.list</field>
        <field name="model">upoferia.socios.beneficiario</field>
        <field name="arch" type="xml">
            <list string="Beneficiario">
                <field name="beneficiario_id"/>
                <field name="nombre"/>
                <field name="telefono"/>
                <field name="email"/>
                <field name="codigo_persona"/>
                <field name="direccion_calle"/>
                <field name="direccion_ciudad"/>
                <field name="direccion_cp"/>
                <field name="socio_id"/>
                <field name="parentesco"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_socios_beneficiario_form_view" model="ir.ui.view">
        <field name="name">upoferia.socios.beneficiario.form</field>
        <field name="model">upoferia.socios.beneficiario</field>
        <field name="arch" type="xml">
            <form string="Beneficiario">
                <sheet>
                    <group>
                        <group>
                            <field name="beneficiario_id" options="{'no_quick_create': True}"/>
                            <field name="socio_id" options="{'no_quick_create': True}"/>
                        </group>
                        <field name="parentesco"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_socios_beneficiario_action" model="ir.actions.act_window">
        <field name="name">Beneficiarios</field>
        <field name="res_model">upoferia.socios.beneficiario</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer beneficiario de la caseta
            </p>
        </field>
    </record>
</odoo>