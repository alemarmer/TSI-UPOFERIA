<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_socios_invitacion_acceso_list_view" model="ir.ui.view">
        <field name="name">upoferia.socios.invitacion_acceso.list</field>
        <field name="model">upoferia.socios.invitacion_acceso</field>
        <field name="arch" type="xml">
            <list string="Invitación de acceso">
                <field name="socio_id"/>
                <field name="persona_id"/>
                <field name="fecha_validez"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_socios_invitacion_acceso_form_view" model="ir.ui.view">
        <field name="name">upoferia.socios.invitacion_acceso.form</field>
        <field name="model">upoferia.socios.invitacion_acceso</field>
        <field name="arch" type="xml">
            <form string="Invitación de acceso">
                <sheet>
                    <group>
                        <field name="socio_id"/>
                        <field name="persona_id"/>
                        <field name="fecha_validez"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Calendar -->
    <record id="upoferia_socios_invitacion_acceso_calendar_view" model="ir.ui.view">
        <field name="name">upoferia.socios.invitacion_acceso.calendar</field>
        <field name="model">upoferia.socios.invitacion_acceso</field>
        <field name="arch" type="xml">
            <calendar string="Invitación de acceso" date_start="fecha_validez" color="persona_id">
                <field name="persona_id"/>
                <field name="socio_id"/>
            </calendar>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_socios_invitacion_acceso_action" model="ir.actions.act_window">
        <field name="name">Invitaciones de acceso</field>
        <field name="res_model">upoferia.socios.invitacion_acceso</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer tipo de socio
            </p>
        </field>
    </record>
</odoo>