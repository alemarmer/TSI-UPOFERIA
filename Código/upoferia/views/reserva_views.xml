<odoo>

  <record id="upoferia_reserva_list_view" model="ir.ui.view">
    <field name="name">upoferia.reserva.list</field>
    <field name="model">upoferia.reserva</field>
    <field name="arch" type="xml">
      <list string="Reservas">
        <field name="dHora_llegada"/>
        <field name="iNum_personas"/>
        <field name="sEstado"/>
      </list>
    </field>
  </record>

  <record id="upoferia_reserva_form_view" model="ir.ui.view">
    <field name="name">upoferia.reserva.form</field>
    <field name="model">upoferia.reserva</field>
    <field name="arch" type="xml">
      <form string="Reserva">
        <header>
          <field name="sEstado" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <field name="dHora_llegada"/>
            <field name="iNum_personas"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- CALENDAR: las reservas de cada día, coloreadas por estado -->
  <record id="upoferia_reserva_calendar_view" model="ir.ui.view">
    <field name="name">upoferia.reserva.calendar</field>
    <field name="model">upoferia.reserva</field>
    <field name="arch" type="xml">
      <calendar string="Reservas" date_start="dHora_llegada" color="sEstado"
                mode="day" event_open_popup="1" quick_create="0">
        <field name="iNum_personas"/>
        <field name="sEstado"/>
      </calendar>
    </field>
  </record>

  <record id="upoferia_reserva_search_view" model="ir.ui.view">
    <field name="name">upoferia.reserva.search</field>
    <field name="model">upoferia.reserva</field>
    <field name="arch" type="xml">
      <search string="Buscar reservas">
        <filter name="proximas" string="Próximas"
                domain="[('dHora_llegada', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
        <filter name="fecha_llegada" string="Fecha de llegada"/>
        <separator/>
        <filter name="pendientes" string="Pendientes" domain="[('sEstado', '=', 'pendiente')]"/>
        <filter name="confirmadas" string="Confirmadas" domain="[('sEstado', '=', 'confirmada')]"/>
        <filter name="canceladas" string="Canceladas" domain="[('sEstado', 'in', ['cancelada', 'no_presentado'])]"/>
        <group>
          <filter name="group_estado" string="Estado" context="{'group_by': 'sEstado'}"/>
          <filter name="group_dia" string="Día" context="{'group_by': 'dHora_llegada:day'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="upoferia_reserva_action" model="ir.actions.act_window">
    <field name="name">Reservas</field>
    <field name="res_model">upoferia.reserva</field>
    <field name="view_mode">list,form,calendar</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera reserva</p>
    </field>
  </record>

</odoo>
