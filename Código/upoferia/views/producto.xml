<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="producto_view_list" model="ir.ui.view">
        <field name="name">upoferia.producto.list</field>
        <field name="model">upoferia.producto</field>
        <field name="arch" type="xml">
            <list>
                <field name="sCodigoInterno"/>
                <field name="sNombre"/>
                <field name="tipo_producto_id"/>
                <field name="fPrecioSocio"/>
                <field name="iXpOtorgada"/>
            </list>
        </field>
    </record>

    <record id="producto_view_form" model="ir.ui.view">
        <field name="name">upoferia.producto.form</field>
        <field name="model">upoferia.producto</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sNombre" placeholder="Nombre"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sCodigoInterno"/>
                            <field name="tipo_producto_id"/>
                            <field name="sAlergenos"/>
                        </group>
                        <group>
                            <field name="fPrecioSocio"/>
                            <field name="iXpOtorgada"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="producto_view_kanban" model="ir.ui.view">
        <field name="name">upoferia.producto.kanban</field>
        <field name="model">upoferia.producto</field>
        <field name="arch" type="xml">
            <kanban default_group_by="tipo_producto_id">
                <templates>
                    <t t-name="card">
                        <field name="sNombre" class="fw-bold fs-5"/>
                        <field name="sCodigoInterno"/>
                        <field name="tipo_producto_id"/>
                        <field name="fPrecioSocio"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="producto_list_action" model="ir.actions.act_window">
        <field name="name">Productos</field>
        <field name="res_model">upoferia.producto</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer producto</p>
        </field>
    </record>

    <menuitem name="Productos" id="producto_menu" parent="barra_menu" action="producto_list_action" sequence="30"/>

</odoo>
