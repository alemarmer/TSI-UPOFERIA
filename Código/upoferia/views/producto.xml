<odoo>
  <record id="upoferia_producto_form_view" model="ir.ui.view">
    <field name="name">upoferia.producto.form</field>
    <field name="model">upoferia.producto</field>
    <field name="arch" type="xml">
      <form string="Productos">
        <sheet layout="auto">
          <group>
            <group>
              <field name="sCodigoInterno" placeholder="CERV-01" />
              <field name="sNombre" />
              <field name="tipo_producto_id" />
              <field name="sAlergenos" />
            </group>
            <group>
              <field name="fPrecioSocio" />
              <field name="iXpOtorgada" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_producto_list_view" model="ir.ui.view">
    <field name="name">upoferia.producto.list</field>
    <field name="model">upoferia.producto</field>
    <field name="arch" type="xml">
      <list string="Productos">
        <field name="sCodigoInterno" />
        <field name="sNombre" />
        <field name="tipo_producto_id" />
        <field name="fPrecioSocio" />
        <field name="iXpOtorgada" />
      </list>
    </field>
  </record>

  <record id="upoferia_producto_kanban_view" model="ir.ui.view">
    <field name="name">upoferia.producto.kanban</field>
    <field name="model">upoferia.producto</field>
    <field name="arch" type="xml">
      <kanban string="Productos" default_group_by="tipo_producto_id">
        <templates>
          <t t-name="card">
            <field name="sNombre" class="fw-bold fs-5" />
            <field name="sCodigoInterno" />
            <field name="tipo_producto_id" />
            <field name="fPrecioSocio" />
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="upoferia_producto_search_view" model="ir.ui.view">
    <field name="name">upoferia.producto.search</field>
    <field name="model">upoferia.producto</field>
    <field name="arch" type="xml">
      <search>
        <field name="sCodigoInterno" />
        <field name="sNombre" />
        <field name="tipo_producto_id" />
        <separator orientation="vertical" />
        <group expand="0" string="Agrupar por...">
          <filter name="group_by_tipo" string="Tipo de producto" context="{'group_by':'tipo_producto_id'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="producto_list_action" model="ir.actions.act_window">
    <field name="name">Productos</field>
    <field name="res_model">upoferia.producto</field>
    <field name="search_view_id" ref="upoferia_producto_search_view" />
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer producto</p>
    </field>
  </record>
</odoo>
