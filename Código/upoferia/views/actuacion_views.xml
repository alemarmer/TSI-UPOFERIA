<odoo>

  <!-- Gracias a _inherits, una actuación puede mostrar los campos de su evento -->
  <record id="upoferia_actuacion_list_view" model="ir.ui.view">
    <field name="name">upoferia.actuacion.list</field>
    <field name="model">upoferia.actuacion</field>
    <field name="arch" type="xml">
      <list string="Actuaciones">
        <field name="sNombre_evento"/>
        <field name="dFecha_hora_inicio"/>
        <field name="dFecha_hora_fin"/>
        <field name="fCache_pactado"/>
        <field name="sEstado"/>
      </list>
    </field>
  </record>

  <record id="upoferia_actuacion_form_view" model="ir.ui.view">
    <field name="name">upoferia.actuacion.form</field>
    <field name="model">upoferia.actuacion</field>
    <field name="arch" type="xml">
      <form string="Actuación">
        <header>
          <field name="sEstado" widget="statusbar" options="{'clickable': '1'}"/>
        </header>
        <sheet>
          <group>
            <group string="Evento">
              <field name="sNombre_evento"/>
              <field name="tipo_evento_id"/>
              <field name="dFecha_hora_inicio"/>
              <field name="dFecha_hora_fin"/>
              <field name="iAforo_reservado"/>
            </group>
            <group string="Actuación">
              <field name="fCache_pactado"/>
            </group>
          </group>
          <notebook>
            <page name="artistas" string="Artistas">
              <field name="artista_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_actuacion_action" model="ir.actions.act_window">
    <field name="name">Actuaciones</field>
    <field name="res_model">upoferia.actuacion</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera actuación</p>
    </field>
  </record>

</odoo>
