<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="movimiento_view_list" model="ir.ui.view">
        <field name="name">upoferia.movimiento.list</field>
        <field name="model">upoferia.movimiento</field>
        <field name="arch" type="xml">
            <list>
                <field name="sReferencia"/>
                <field name="dFecha"/>
                <field name="selTipo"/>
                <field name="sConcepto"/>
                <field name="metodo_pago_id"/>
                <field name="fImporte" sum="Total"/>
                <field name="selEstado"/>
            </list>
        </field>
    </record>

    <record id="movimiento_view_form" model="ir.ui.view">
        <field name="name">upoferia.movimiento.form</field>
        <field name="model">upoferia.movimiento</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="selEstado" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sReferencia" placeholder="Referencia"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="dFecha"/>
                            <field name="selTipo"/>
                            <field name="fImporte"/>
                            <field name="sConcepto"/>
                            <field name="sPeriodo"/>
                        </group>
                        <group>
                            <field name="metodo_pago_id"/>
                            <field name="caja_id"/>
                            <field name="cuenta_bancaria_id"/>
                            <field name="categoria_economica_id"/>
                            <field name="cuota_id"/>
                            <field name="ticket_id"/>
                            <field name="linea_presupuesto_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="movimiento_view_calendar" model="ir.ui.view">
        <field name="name">upoferia.movimiento.calendar</field>
        <field name="model">upoferia.movimiento</field>
        <field name="arch" type="xml">
            <calendar string="Movimientos" date_start="dFecha" color="metodo_pago_id" mode="month">
                <field name="sReferencia"/>
                <field name="selTipo"/>
                <field name="fImporte"/>
            </calendar>
        </field>
    </record>

    <record id="movimiento_list_action" model="ir.actions.act_window">
        <field name="name">Movimientos</field>
        <field name="res_model">upoferia.movimiento</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer movimiento</p>
        </field>
    </record>

    <menuitem name="Movimientos" id="movimiento_menu" parent="tesoreria_menu" action="movimiento_list_action" sequence="10"/>

</odoo>
