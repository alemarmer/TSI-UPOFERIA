<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cuenta_bancaria_view_list" model="ir.ui.view">
        <field name="name">upoferia.cuenta_bancaria.list</field>
        <field name="model">upoferia.cuenta_bancaria</field>
        <field name="arch" type="xml">
            <list>
                <field name="sIban"/>
                <field name="sBanco"/>
                <field name="sTitular"/>
                <field name="bActiva"/>
            </list>
        </field>
    </record>

    <record id="cuenta_bancaria_view_form" model="ir.ui.view">
        <field name="name">upoferia.cuenta_bancaria.form</field>
        <field name="model">upoferia.cuenta_bancaria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sIban" placeholder="IBAN"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sBanco"/>
                            <field name="sTitular"/>
                        </group>
                        <group>
                            <field name="bActiva"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cuenta_bancaria_view_kanban" model="ir.ui.view">
        <field name="name">upoferia.cuenta_bancaria.kanban</field>
        <field name="model">upoferia.cuenta_bancaria</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="sIban" class="fw-bold fs-5"/>
                        <field name="sBanco"/>
                        <field name="sTitular"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="cuenta_bancaria_list_action" model="ir.actions.act_window">
        <field name="name">Cuentas bancarias</field>
        <field name="res_model">upoferia.cuenta_bancaria</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera cuenta bancaria</p>
        </field>
    </record>

    <menuitem name="Cuentas bancarias" id="cuenta_bancaria_menu" parent="catalogos_menu" action="cuenta_bancaria_list_action" sequence="50"/>

</odoo>
