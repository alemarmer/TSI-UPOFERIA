<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="linea_ticket_view_list" model="ir.ui.view">
        <field name="name">upoferia.linea_ticket.list</field>
        <field name="model">upoferia.linea_ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="ticket_id"/>
                <field name="iNumeroLinea"/>
                <field name="producto_id"/>
                <field name="iCantidad" sum="Total"/>
                <field name="fPrecioUnitario"/>
            </list>
        </field>
    </record>

    <record id="linea_ticket_view_form" model="ir.ui.view">
        <field name="name">upoferia.linea_ticket.form</field>
        <field name="model">upoferia.linea_ticket</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="ticket_id"/>
                            <field name="iNumeroLinea"/>
                            <field name="producto_id"/>
                        </group>
                        <group>
                            <field name="iCantidad"/>
                            <field name="fPrecioUnitario"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="linea_ticket_view_graph" model="ir.ui.view">
        <field name="name">upoferia.linea_ticket.graph</field>
        <field name="model">upoferia.linea_ticket</field>
        <field name="arch" type="xml">
            <graph string="Productos vendidos" type="bar">
                <field name="producto_id"/>
                <field name="iCantidad" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="linea_ticket_list_action" model="ir.actions.act_window">
        <field name="name">Líneas de ticket</field>
        <field name="res_model">upoferia.linea_ticket</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera línea de ticket</p>
        </field>
    </record>

    <menuitem name="Líneas de ticket" id="linea_ticket_menu" parent="barra_menu" action="linea_ticket_list_action" sequence="20"/>

</odoo>
