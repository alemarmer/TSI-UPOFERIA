<odoo>
    <data>
        <record id="view_feria_transaccion_list" model="ir.ui.view">
            <field name="name">feria.transaccion.list</field>
            <field name="model">feria.transaccion</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sIdTransaccion"/>
                    <field name="tipo_transaccion_id"/>
                    <field name="proveedor_id"/>
                    <field name="dFechaInicial"/>
                    <field name="fImporte"/>
                    <field name="sEstado"/>
                </list>
            </field>
        </record>

        <record id="view_feria_transaccion_form" model="ir.ui.view">
            <field name="name">feria.transaccion.form</field>
            <field name="model">feria.transaccion</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirmar" string="Confirmar" type="object" class="btn-primary"
                                invisible="sCodigoTipo != 'PED' or sEstado != 'borrador'"/>
                        <button name="action_recibir" string="Recibido" type="object" class="btn-primary"
                                invisible="sCodigoTipo != 'PED' or sEstado != 'confirmado'"/>
                        <button name="action_cancelar" string="Cancelar" type="object"
                                invisible="sCodigoTipo != 'PED' or sEstado not in ('borrador', 'confirmado')"/>
                        <button name="action_hacer" string="Hecho" type="object" class="btn-primary"
                                invisible="sCodigoTipo != 'ALB' or sEstado != 'previsto'"/>
                        <button name="action_pagar" string="Pagada" type="object" class="btn-primary"
                                invisible="sCodigoTipo not in ('FAC', 'ABO') or sEstado not in ('pendiente', 'vencida')"/>
                        <button name="action_marcar_vencida" string="Vencida" type="object"
                                invisible="sCodigoTipo not in ('FAC', 'ABO') or sEstado != 'pendiente'"/>
                        <button name="action_activar" string="Activar" type="object" class="btn-primary"
                                invisible="sCodigoTipo != 'CON' or sEstado != 'borrador'"/>
                        <button name="action_marcar_vencido" string="Vencido" type="object"
                                invisible="sCodigoTipo != 'CON' or sEstado != 'vigente'"/>
                        <button name="action_rescindir" string="Rescindir" type="object"
                                invisible="sCodigoTipo != 'CON' or sEstado != 'vigente'"/>
                    </header>
                    <sheet>
                        <field name="sCodigoTipo" invisible="1"/>
                        <group>
                            <group>
                                <field name="sIdTransaccion"/>
                                <field name="tipo_transaccion_id" readonly="id"/>
                                <field name="proveedor_id"/>
                                <field name="sEstado" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="dFechaInicial"/>
                                <field name="dVencimiento" invisible="sCodigoTipo not in ('FAC', 'ABO')"/>
                                <field name="dFechaPrevistaFin" invisible="sCodigoTipo not in ('PED', 'ALB', 'CON')"/>
                                <field name="fImporte" invisible="sCodigoTipo == 'ALB'"/>
                                <field name="fImporteFacturado" invisible="sCodigoTipo != 'CON'"/>
                                <field name="sRefProveedor" invisible="sCodigoTipo not in ('FAC', 'ABO')"/>
                                <field name="sDocumento" invisible="sCodigoTipo != 'CON'"/>
                                <field name="bRenovacionAuto" invisible="sCodigoTipo != 'CON'"/>
                                <field name="linea_presupuesto_id" invisible="sCodigoTipo != 'CON'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Líneas" invisible="sCodigoTipo not in ('PED', 'FAC', 'ABO')">
                                <field name="linea_ids">
                                    <list editable="bottom">
                                        <field name="iNumeroLinea"/>
                                        <field name="producto_id"/>
                                        <field name="iCantidad"/>
                                        <field name="fPrecioUnitario"/>
                                        <field name="fSubtotal"/>
                                        <field name="iCantidadRecibida" column_invisible="parent.sCodigoTipo != 'PED'"/>
                                        <field name="iCantidadFacturada" column_invisible="parent.sCodigoTipo != 'PED'"/>
                                        <field name="linea_pedido_id" column_invisible="parent.sCodigoTipo not in ('FAC', 'ABO')"
                                               domain="[('transaccion_id.tipo_transaccion_id.sCodigo', '=', 'PED')]"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Movimientos" invisible="sCodigoTipo not in ('FAC', 'ABO')">
                                <field name="movimiento_ids" readonly="1">
                                    <list>
                                        <field name="referencia"/>
                                        <field name="fecha"/>
                                        <field name="importe"/>
                                        <field name="estado"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Actuaciones" invisible="sCodigoTipo != 'CON'">
                                <field name="actuacion_ids" readonly="1">
                                    <list>
                                        <field name="evento_id"/>
                                        <field name="fCache_pactado"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Salidas">
                                <field name="salida_ids" readonly="1">
                                    <list>
                                        <field name="dFecha_hora_salida"/>
                                        <field name="carruaje_id"/>
                                        <field name="sEstado"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Origen y derivadas">
                                <group>
                                    <field name="transaccion_origen_id"/>
                                </group>
                                <field name="transaccion_derivada_ids" readonly="1">
                                    <list>
                                        <field name="sIdTransaccion"/>
                                        <field name="tipo_transaccion_id"/>
                                        <field name="fImporte"/>
                                        <field name="sEstado"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_feria_transaccion" model="ir.actions.act_window">
            <field name="name">Transacciones</field>
            <field name="res_model">feria.transaccion</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_feria_linea_transaccion" model="ir.actions.act_window">
            <field name="name">Líneas de transacción</field>
            <field name="res_model">feria.linea_transaccion</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_feria_tipo_transaccion" model="ir.actions.act_window">
            <field name="name">Tipos de transacción</field>
            <field name="res_model">feria.tipo_transaccion</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_feria_proveedor" model="ir.actions.act_window">
            <field name="name">Proveedores</field>
            <field name="res_model">feria.proveedor</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_feria_categoria_proveedor" model="ir.actions.act_window">
            <field name="name">Categorías de proveedor</field>
            <field name="res_model">feria.categoria_proveedor</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_feria_marca" model="ir.actions.act_window">
            <field name="name">Marcas</field>
            <field name="res_model">feria.marca</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_feria_exhibicion_marca" model="ir.actions.act_window">
            <field name="name">Exhibiciones</field>
            <field name="res_model">feria.exhibicion_marca</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_feria_espacio_publicitario" model="ir.actions.act_window">
            <field name="name">Espacios publicitarios</field>
            <field name="res_model">feria.espacio_publicitario</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_feria_servicio" model="ir.actions.act_window">
            <field name="name">Servicios</field>
            <field name="res_model">feria.servicio</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_feria_servicio_proveedor" model="ir.actions.act_window">
            <field name="name">Tarifas de proveedores</field>
            <field name="res_model">feria.servicio_proveedor</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_feria_tecnico" model="ir.actions.act_window">
            <field name="name">Técnicos</field>
            <field name="res_model">feria.tecnico</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_feria_root" name="Feria" sequence="10"/>

        <menuitem id="menu_feria_compras" name="Compras" parent="menu_feria_root" sequence="10"/>
        <menuitem id="menu_feria_transaccion" name="Transacciones" parent="menu_feria_compras" action="action_feria_transaccion" sequence="10"/>
        <menuitem id="menu_feria_linea_transaccion" name="Líneas" parent="menu_feria_compras" action="action_feria_linea_transaccion" sequence="20"/>
        <menuitem id="menu_feria_tipo_transaccion" name="Tipos de transacción" parent="menu_feria_compras" action="action_feria_tipo_transaccion" sequence="30"/>

        <menuitem id="menu_feria_proveedores" name="Proveedores" parent="menu_feria_root" sequence="20"/>
        <menuitem id="menu_feria_proveedor" name="Proveedores" parent="menu_feria_proveedores" action="action_feria_proveedor" sequence="10"/>
        <menuitem id="menu_feria_categoria_proveedor" name="Categorías" parent="menu_feria_proveedores" action="action_feria_categoria_proveedor" sequence="20"/>

        <menuitem id="menu_feria_patrocinios" name="Patrocinios" parent="menu_feria_root" sequence="30"/>
        <menuitem id="menu_feria_marca" name="Marcas" parent="menu_feria_patrocinios" action="action_feria_marca" sequence="10"/>
        <menuitem id="menu_feria_exhibicion_marca" name="Exhibiciones" parent="menu_feria_patrocinios" action="action_feria_exhibicion_marca" sequence="20"/>
        <menuitem id="menu_feria_espacio_publicitario" name="Espacios publicitarios" parent="menu_feria_patrocinios" action="action_feria_espacio_publicitario" sequence="30"/>
        <menuitem id="menu_feria_servicio" name="Servicios" parent="menu_feria_patrocinios" action="action_feria_servicio" sequence="40"/>
        <menuitem id="menu_feria_servicio_proveedor" name="Tarifas" parent="menu_feria_patrocinios" action="action_feria_servicio_proveedor" sequence="50"/>
        <menuitem id="menu_feria_tecnico" name="Técnicos" parent="menu_feria_patrocinios" action="action_feria_tecnico" sequence="60"/>

    </data>
</odoo>