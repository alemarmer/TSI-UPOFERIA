<odoo>
  <record id="upoferia_inspeccion_form_view" model="ir.ui.view">
    <field name="name">upoferia.inspeccion.form</field>
    <field name="model">upoferia.inspeccion</field>
    <field name="arch" type="xml">
      <form string="Inspecciones">
        <header>
          <field name="sEstado" widget="statusbar" options="{'clickable': '1'}" />
        </header>
        <sheet layout="auto">
          <group>
            <field name="sReferencia" />
            <field name="caseta_id" widget="many2one" />
            <field name="sTipo" />
            <field name="sOrganismo" />
            <field name="dFecha" />
            <field name="sResultado" />
            <field name="fPorcentajeSuperado" />
            <field name="sDocumento" />
            <field name="microchip" widget="many2one" />
          </group>
          <notebook>
            <page name="puntos_control" string="Puntos de control">
              <group>
                <field name="punto_control_ids" widget="one2many" />
              </group>
            </page>
            <page name="inspectores" string="Inspectores">
              <group>
                <field name="inspeccion_inspector_ids" widget="one2many" />
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_inspeccion_list_view" model="ir.ui.view">
    <field name="name">upoferia.inspeccion.list</field>
    <field name="model">upoferia.inspeccion</field>
    <field name="arch" type="xml">
      <list string="Inspecciones">
        <field name="sReferencia" />
        <field name="caseta_id" widget="many2one" />
        <field name="sTipo" />
        <field name="sOrganismo" />
        <field name="dFecha" />
        <field name="sEstado" />
        <field name="sResultado" />
        <field name="fPorcentajeSuperado" />
        <field name="microchip" widget="many2one" />
      </list>
    </field>
  </record>

  <record id="upoferia_inspeccion_calendar_view" model="ir.ui.view">
    <field name="name">upoferia.inspeccion.calendar</field>
    <field name="model">upoferia.inspeccion</field>
    <field name="arch" type="xml">
      <calendar string="Inspecciones" color="sTipo" date_start="dFecha" mode="month">
        <field name="sReferencia" />
        <field name="caseta_id" />
      </calendar>
    </field>
  </record>

  <record id="upoferia_inspeccion_search_view" model="ir.ui.view">
    <field name="name">upoferia.inspeccion.search</field>
    <field name="model">upoferia.inspeccion</field>
    <field name="arch" type="xml">
      <search>
        <field name="sReferencia" />
        <filter name="search_realizadas" string="Realizadas" domain="[('sEstado','=','realizada')]" />
        <group expand="0" string="Agrupar por...">
          <filter name="group_by_caseta" string="Caseta" context="{'group_by':'caseta_id'}" />
          <filter name="group_by_tipo" string="Tipo" context="{'group_by':'sTipo'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="inspeccion_list_action" model="ir.actions.act_window">
    <field name="name">Inspecciones</field>
    <field name="res_model">upoferia.inspeccion</field>
    <field name="search_view_id" ref="upoferia_inspeccion_search_view" />
    <field name="view_mode">list,form,calendar</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera inspección</p>
    </field>
  </record>
</odoo>
