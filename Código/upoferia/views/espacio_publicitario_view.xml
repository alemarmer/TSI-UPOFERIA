<odoo>
  <record id="upoferia_espacio_publicitario_form_view" model="ir.ui.view">
    <field name="name">upoferia.espacio_publicitario.form</field>
    <field name="model">upoferia.espacio_publicitario</field>
    <field name="arch" type="xml">
      <form string="Espacios publicitarios">
        <sheet layout="auto">
          <group>
            <group>
              <field name="sCodigoLugar" placeholder="PORTADA-01" />
              <field name="sTipo" />
              <field name="sUbicacionExacta" />
              <field name="bIluminado" />
              <field name="zona_caseta_id" />
            </group>
            <group>
              <field name="fAltoM" />
              <field name="fAnchoM" />
              <field name="fSuperficieM2" />
            </group>
          </group>
          <notebook>
            <page name="exhibiciones" string="Exhibiciones">
              <field name="exhibicion_ids" readonly="1" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_espacio_publicitario_list_view" model="ir.ui.view">
    <field name="name">upoferia.espacio_publicitario.list</field>
    <field name="model">upoferia.espacio_publicitario</field>
    <field name="arch" type="xml">
      <list string="Espacios publicitarios">
        <field name="sCodigoLugar" />
        <field name="sTipo" />
        <field name="fAltoM" />
        <field name="fAnchoM" />
        <field name="fSuperficieM2" />
      </list>
    </field>
  </record>

  <record id="espacio_publicitario_list_action" model="ir.actions.act_window">
    <field name="name">Espacios publicitarios</field>
    <field name="res_model">upoferia.espacio_publicitario</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer espacio publicitario</p>
    </field>
  </record>
</odoo>
