<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_control_accesos_evento_puerta_list_view" model="ir.ui.view">
        <field name="name">upoferia.control_accesos.evento_puerta.list</field>
        <field name="model">upoferia.control_accesos.evento_puerta</field>
        <field name="arch" type="xml">
            <list string="Evento de Puerta">
                <field name="evento_puerta_num"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_control_accesos_evento_puerta_form_view" model="ir.ui.view">
        <field name="name">upoferia.control_accesos.evento_puerta.form</field>
        <field name="model">upoferia.control_accesos.evento_puerta</field>
        <field name="arch" type="xml">
            <form string="Evento de Puerta">
                <sheet>
                    <group>
                        <field name="evento_puerta_num" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_control_accesos_evento_puerta_action" model="ir.actions.act_window">
        <field name="name">Eventos de Puerta</field>
        <field name="res_model">upoferia.control_accesos.evento_puerta</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer evento de puerta para comenzar a gestionar el control de accesos.
            </p>
        </field>
    </record>
</odoo>