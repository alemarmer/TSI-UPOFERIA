<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_control_accesos_registro_accesos_list_view" model="ir.ui.view">
        <field name="name">upoferia.control_accesos.registro_accesos.list</field>
        <field name="model">upoferia.control_accesos.registro_accesos</field>
        <field name="arch" type="xml">
            <list string="Registros de Accesos">
                <field name="punto_acceso_id"/>
                <field name="fecha_hora"/>
                <field name="metodo_acceso"/>
                <field name="tipo_movimiento"/>
                <field name="persona_id"/>
                <field name="evento_puerta_id"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_control_accesos_registro_accesos_form_view" model="ir.ui.view">
        <field name="name">upoferia.control_accesos.registro_accesos.form</field>
        <field name="model">upoferia.control_accesos.registro_accesos</field>
        <field name="arch" type="xml">
            <form string="Registros de Accesos">
                <sheet>
                    <group>
                        <field name="punto_acceso_id"/>
                        <field name="fecha_hora"/>
                        <field name="metodo_acceso"/>
                        <field name="tipo_movimiento"/>
                        <field name="persona_id"/>
                        <field name="evento_puerta_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_control_accesos_registro_accesos_action" model="ir.actions.act_window">
        <field name="name">Registros de Accesos</field>
        <field name="res_model">upoferia.control_accesos.registro_accesos</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer registro de acceso para comenzar a gestionar el control de accesos.
            </p>
        </field>
    </record>
</odoo>