<?xml version="1.0" encoding="utf-8"?>
<!-- Autor: Juanjo (Personal - RRHH y Turnos) -->
<odoo>

    <record id="upoferia_rrhh_entrega_uniforme_list_view" model="ir.ui.view">
        <field name="name">upoferia.rrhh.entrega_uniforme.list</field>
        <field name="model">upoferia.rrhh.entrega_uniforme</field>
        <field name="arch" type="xml">
            <list decoration-info="estado == 'entregado'" decoration-muted="estado == 'devuelto'"
                  decoration-danger="estado in ('perdido', 'deteriorado')">
                <field name="empleado_id"/>
                <field name="prenda"/>
                <field name="talla"/>
                <field name="cantidad"/>
                <field name="fecha_entrega"/>
                <field name="fecha_devolucion"/>
                <field name="estado" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="upoferia_rrhh_entrega_uniforme_form_view" model="ir.ui.view">
        <field name="name">upoferia.rrhh.entrega_uniforme.form</field>
        <field name="model">upoferia.rrhh.entrega_uniforme</field>
        <field name="arch" type="xml">
            <form string="Entrega de uniforme">
                <header>
                    <button name="action_registrar_devolucion" type="object" string="Registrar devolución"
                            class="btn-primary" invisible="estado != 'entregado'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="entregado,devuelto"/>
                </header>
                <sheet>
                    <group>
                        <group string="Prenda">
                            <field name="empleado_id"/>
                            <field name="prenda"/>
                            <field name="talla"/>
                            <field name="cantidad"/>
                        </group>
                        <group string="Fechas">
                            <field name="fecha_entrega"/>
                            <field name="fecha_devolucion"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="upoferia_rrhh_entrega_uniforme_search_view" model="ir.ui.view">
        <field name="name">upoferia.rrhh.entrega_uniforme.search</field>
        <field name="model">upoferia.rrhh.entrega_uniforme</field>
        <field name="arch" type="xml">
            <search>
                <field name="empleado_id"/>
                <field name="prenda"/>
                <field name="talla"/>
                <filter string="Pendientes de devolver" name="entregadas" domain="[('estado', '=', 'entregado')]"/>
                <filter string="Devueltas" name="devueltas" domain="[('estado', '=', 'devuelto')]"/>
                <filter string="Perdidas o deterioradas" name="incidencias"
                        domain="[('estado', 'in', ['perdido', 'deteriorado'])]"/>
                <separator/>
                <filter string="Fecha de entrega" name="filter_fecha_entrega" date="fecha_entrega"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empleado" name="group_empleado" context="{'group_by': 'empleado_id'}"/>
                    <filter string="Prenda" name="group_prenda" context="{'group_by': 'prenda'}"/>
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="upoferia_rrhh_entrega_uniforme_calendar_view" model="ir.ui.view">
        <field name="name">upoferia.rrhh.entrega_uniforme.calendar</field>
        <field name="model">upoferia.rrhh.entrega_uniforme</field>
        <field name="arch" type="xml">
            <calendar string="Entregas de uniforme" date_start="fecha_entrega" date_stop="fecha_devolucion"
                      color="empleado_id" mode="month" quick_create="0">
                <field name="empleado_id"/>
                <field name="prenda"/>
                <field name="estado"/>
            </calendar>
        </field>
    </record>

    <record id="upoferia_rrhh_entrega_uniforme_action" model="ir.actions.act_window">
        <field name="name">Entregas de uniforme</field>
        <field name="res_model">upoferia.rrhh.entrega_uniforme</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

</odoo>
