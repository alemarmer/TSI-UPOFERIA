<odoo>

  <!-- Vistas de Plan de montaje -->
  <record id="upoferia_plan_montaje_list_view" model="ir.ui.view">
    <field name="name">upoferia.plan_montaje.list</field>
    <field name="model">upoferia.plan_montaje</field>
    <field name="arch" type="xml">
      <list string="Planes de montaje">
        <field name="sNombre"/>
        <field name="sEdicion"/>
        <field name="dFechaInicio"/>
        <field name="dFechaFin"/>
        <field name="selEstado"/>
        <field name="sResponsable"/>
      </list>
    </field>
  </record>

  <record id="upoferia_plan_montaje_form_view" model="ir.ui.view">
    <field name="name">upoferia.plan_montaje.form</field>
    <field name="model">upoferia.plan_montaje</field>
    <field name="arch" type="xml">
      <form string="Plan de montaje">
        <header>
          <field name="selEstado" widget="statusbar" options="{'clickable': '1'}"/>
        </header>
        <sheet>
          <group>
            <group string="Plan">
              <field name="sNombre"/>
              <field name="sEdicion"/>
              <field name="sResponsable"/>
            </group>
            <group string="Fechas">
              <field name="dFechaInicio"/>
              <field name="dFechaFin"/>
            </group>
          </group>
          <notebook>
            <page name="fases" string="Fases">
              <field name="fase_montaje_ids">
                <list>
                  <field name="iSecuencia"/>
                  <field name="sNombre"/>
                  <field name="sDescripcion"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_plan_montaje_action" model="ir.actions.act_window">
    <field name="name">Planes de montaje</field>
    <field name="res_model">upoferia.plan_montaje</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer plan de montaje</p>
    </field>
  </record>

</odoo>
