<odoo>
  <record id="upoferia_categoria_economica_form_view" model="ir.ui.view">
    <field name="name">upoferia.categoria_economica.form</field>
    <field name="model">upoferia.categoria_economica</field>
    <field name="arch" type="xml">
      <form string="Categorías económicas">
        <sheet layout="auto">
          <group>
            <field name="sNombre" placeholder="Suministros" />
            <field name="selTipo" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_categoria_economica_list_view" model="ir.ui.view">
    <field name="name">upoferia.categoria_economica.list</field>
    <field name="model">upoferia.categoria_economica</field>
    <field name="arch" type="xml">
      <list string="Categorías económicas">
        <field name="sNombre" />
        <field name="selTipo" />
      </list>
    </field>
  </record>

  <record id="upoferia_categoria_economica_kanban_view" model="ir.ui.view">
    <field name="name">upoferia.categoria_economica.kanban</field>
    <field name="model">upoferia.categoria_economica</field>
    <field name="arch" type="xml">
      <kanban string="Categorías económicas" default_group_by="selTipo">
        <templates>
          <t t-name="card">
            <field name="sNombre" class="fw-bold fs-5" />
            <field name="selTipo" />
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="upoferia_categoria_economica_search_view" model="ir.ui.view">
    <field name="name">upoferia.categoria_economica.search</field>
    <field name="model">upoferia.categoria_economica</field>
    <field name="arch" type="xml">
      <search>
        <field name="sNombre" />
        <filter name="search_ingresos" string="Ingresos" domain="[('selTipo','=','ingreso')]" />
        <filter name="search_gastos" string="Gastos" domain="[('selTipo','=','gasto')]" />
        <separator orientation="vertical" />
        <group expand="0" string="Agrupar por...">
          <filter name="group_by_tipo" string="Tipo" context="{'group_by':'selTipo'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="categoria_economica_list_action" model="ir.actions.act_window">
    <field name="name">Categorías económicas</field>
    <field name="res_model">upoferia.categoria_economica</field>
    <field name="search_view_id" ref="upoferia_categoria_economica_search_view" />
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera categoría económica</p>
    </field>
  </record>
</odoo>
