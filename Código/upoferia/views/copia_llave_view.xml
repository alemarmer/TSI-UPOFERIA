<odoo>
  <record id="upoferia_copia_llave_form_view" model="ir.ui.view">
    <field name="name">upoferia.copia_llave.form</field>
    <field name="model">upoferia.copia_llave</field>
    <field name="arch" type="xml">
      <form string="Copias de llave">
        <header>
          <field name="sEstado" widget="statusbar" options="{'clickable': '1'}" />
        </header>
        <sheet layout="auto">
          <group>
            <field name="iNumeroCopia" />
            <field name="dFechaEntrega" />
            <field name="dFechaBaja" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_copia_llave_list_view" model="ir.ui.view">
    <field name="name">upoferia.copia_llave.list</field>
    <field name="model">upoferia.copia_llave</field>
    <field name="arch" type="xml">
      <list string="Copias de llave">
        <field name="iNumeroCopia" />
        <field name="dFechaEntrega" />
        <field name="dFechaBaja" />
        <field name="sEstado" />
      </list>
    </field>
  </record>

  <record id="copia_llave_list_action" model="ir.actions.act_window">
    <field name="name">Copias de llave</field>
    <field name="res_model">upoferia.copia_llave</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera copia de llave</p>
    </field>
  </record>
</odoo>
