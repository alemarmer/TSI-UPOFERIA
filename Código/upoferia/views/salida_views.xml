<odoo>

  <record id="upoferia_salida_list_view" model="ir.ui.view">
    <field name="name">upoferia.salida.list</field>
    <field name="model">upoferia.salida</field>
    <field name="arch" type="xml">
      <list string="Salidas">
        <field name="carruaje_id"/>
        <field name="dFecha_hora_salida"/>
        <field name="dFecha_hora_vuelta"/>
        <field name="iNum_pasajeros"/>
        <field name="sEstado"/>
      </list>
    </field>
  </record>

  <record id="upoferia_salida_form_view" model="ir.ui.view">
    <field name="name">upoferia.salida.form</field>
    <field name="model">upoferia.salida</field>
    <field name="arch" type="xml">
      <form string="Salida">
        <header>
          <field name="sEstado" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="carruaje_id"/>
              <field name="iNum_pasajeros"/>
            </group>
            <group>
              <field name="dFecha_hora_salida"/>
              <field name="dFecha_hora_vuelta"/>
            </group>
          </group>
          <notebook>
            <page name="caballos" string="Caballos">
              <field name="caballo_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- CALENDAR: cuándo sale cada carruaje, coloreado por carruaje -->
  <record id="upoferia_salida_calendar_view" model="ir.ui.view">
    <field name="name">upoferia.salida.calendar</field>
    <field name="model">upoferia.salida</field>
    <field name="arch" type="xml">
      <calendar string="Salidas" date_start="dFecha_hora_salida" date_stop="dFecha_hora_vuelta"
                color="carruaje_id" mode="week">
        <field name="carruaje_id"/>
        <field name="iNum_pasajeros"/>
        <field name="sEstado"/>
      </calendar>
    </field>
  </record>

  <record id="upoferia_salida_search_view" model="ir.ui.view">
    <field name="name">upoferia.salida.search</field>
    <field name="model">upoferia.salida</field>
    <field name="arch" type="xml">
      <search string="Buscar salidas">
        <field name="carruaje_id"/>
        <field name="caballo_ids"/>
        <filter name="proximas" string="Próximas"
                domain="[('dFecha_hora_salida', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
        <filter name="fecha_salida" string="Fecha de salida" date="dFecha_hora_salida"/>
        <separator/>
        <filter name="programadas" string="Programadas" domain="[('sEstado', '=', 'programada')]"/>
        <filter name="en_curso" string="En curso" domain="[('sEstado', '=', 'en_curso')]"/>
        <filter name="canceladas" string="Canceladas" domain="[('sEstado', '=', 'cancelada')]"/>
        <group>
          <filter name="group_carruaje" string="Carruaje" context="{'group_by': 'carruaje_id'}"/>
          <filter name="group_estado" string="Estado" context="{'group_by': 'sEstado'}"/>
          <filter name="group_dia" string="Día" context="{'group_by': 'dFecha_hora_salida:day'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="upoferia_salida_action" model="ir.actions.act_window">
    <field name="name">Salidas</field>
    <field name="res_model">upoferia.salida</field>
    <field name="view_mode">list,form,calendar</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Programa la primera salida</p>
    </field>
  </record>

</odoo>
