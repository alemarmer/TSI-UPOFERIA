<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tipo_producto_view_list" model="ir.ui.view">
        <field name="name">upoferia.tipo_producto.list</field>
        <field name="model">upoferia.tipo_producto</field>
        <field name="arch" type="xml">
            <list>
                <field name="sNombre"/>
                <field name="padre_id"/>
            </list>
        </field>
    </record>

    <record id="tipo_producto_view_form" model="ir.ui.view">
        <field name="name">upoferia.tipo_producto.form</field>
        <field name="model">upoferia.tipo_producto</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sNombre" placeholder="Nombre"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="padre_id"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos">
                            <field name="producto_ids">
                                <list>
                                    <field name="sCodigoInterno"/>
                                    <field name="sNombre"/>
                                    <field name="fPrecioSocio"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tipo_producto_view_kanban" model="ir.ui.view">
        <field name="name">upoferia.tipo_producto.kanban</field>
        <field name="model">upoferia.tipo_producto</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="sNombre" class="fw-bold fs-5"/>
                        <field name="padre_id"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="tipo_producto_list_action" model="ir.actions.act_window">
        <field name="name">Tipos de producto</field>
        <field name="res_model">upoferia.tipo_producto</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer tipo de producto</p>
        </field>
    </record>

    <menuitem name="Tipos de producto" id="tipo_producto_menu" parent="barra_menu" action="tipo_producto_list_action" sequence="40"/>

</odoo>
