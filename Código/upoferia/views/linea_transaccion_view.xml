<odoo>
  <record id="upoferia_linea_transaccion_form_view" model="ir.ui.view">
    <field name="name">upoferia.linea_transaccion.form</field>
    <field name="model">upoferia.linea_transaccion</field>
    <field name="arch" type="xml">
      <form string="Línea de transacción">
        <sheet layout="auto">
          <group>
            <group>
              <field name="transaccion_id" />
              <field name="iNumeroLinea" />
              <field name="producto_id" />
              <field name="linea_pedido_id" domain="[('transaccion_id.tipo_transaccion_id.sCodigo', '=', 'PED')]" />
            </group>
            <group>
              <field name="iCantidad" />
              <field name="fPrecioUnitario" />
              <field name="fSubtotal" />
              <field name="iCantidadRecibida" />
              <field name="iCantidadFacturada" />
            </group>
          </group>
          <notebook>
            <page name="lineas_factura" string="Líneas de factura">
              <field name="linea_factura_ids" readonly="1">
                <list>
                  <field name="transaccion_id" />
                  <field name="iNumeroLinea" />
                  <field name="iCantidad" sum="Total" />
                  <field name="fSubtotal" sum="Total" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_linea_transaccion_list_view" model="ir.ui.view">
    <field name="name">upoferia.linea_transaccion.list</field>
    <field name="model">upoferia.linea_transaccion</field>
    <field name="arch" type="xml">
      <list string="Líneas de transacción">
        <field name="transaccion_id" />
        <field name="iNumeroLinea" />
        <field name="producto_id" />
        <field name="iCantidad" />
        <field name="fPrecioUnitario" />
        <field name="fSubtotal" sum="Total" />
        <field name="iCantidadRecibida" />
        <field name="iCantidadFacturada" />
      </list>
    </field>
  </record>

  <record id="linea_transaccion_list_action" model="ir.actions.act_window">
    <field name="name">Líneas de transacción</field>
    <field name="res_model">upoferia.linea_transaccion</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Las líneas se crean desde el formulario de cada transacción</p>
    </field>
  </record>
</odoo>
