<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ticket_view_list" model="ir.ui.view">
        <field name="name">upoferia.ticket.list</field>
        <field name="model">upoferia.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="sReferencia"/>
                <field name="dtFecha"/>
                <field name="tarifa_id"/>
            </list>
        </field>
    </record>

    <record id="ticket_view_form" model="ir.ui.view">
        <field name="name">upoferia.ticket.form</field>
        <field name="model">upoferia.ticket</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sReferencia" placeholder="Referencia"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="dtFecha"/>
                        </group>
                        <group>
                            <field name="tarifa_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="iNumeroLinea"/>
                                    <field name="producto_id"/>
                                    <field name="iCantidad"/>
                                    <field name="fPrecioUnitario"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ticket_view_calendar" model="ir.ui.view">
        <field name="name">upoferia.ticket.calendar</field>
        <field name="model">upoferia.ticket</field>
        <field name="arch" type="xml">
            <calendar string="Tickets" date_start="dtFecha" color="tarifa_id" mode="week">
                <field name="sReferencia"/>
                <field name="tarifa_id"/>
            </calendar>
        </field>
    </record>

    <record id="ticket_list_action" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">upoferia.ticket</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer ticket</p>
        </field>
    </record>

    <menuitem name="Tickets" id="ticket_menu" parent="barra_menu" action="ticket_list_action" sequence="10"/>

</odoo>
