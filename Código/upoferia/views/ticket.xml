<odoo>
  <record id="upoferia_ticket_form_view" model="ir.ui.view">
    <field name="name">upoferia.ticket.form</field>
    <field name="model">upoferia.ticket</field>
    <field name="arch" type="xml">
      <form string="Tickets">
        <sheet layout="auto">
          <group>
            <group>
              <field name="sReferencia" placeholder="TCK-2026-001" />
              <field name="dtFecha" />
            </group>
            <group>
              <field name="tarifa_id" />
            </group>
          </group>
          <notebook>
            <page name="lineas" string="Líneas">
              <field name="linea_ids" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_ticket_list_view" model="ir.ui.view">
    <field name="name">upoferia.ticket.list</field>
    <field name="model">upoferia.ticket</field>
    <field name="arch" type="xml">
      <list string="Tickets">
        <field name="sReferencia" />
        <field name="dtFecha" />
        <field name="tarifa_id" />
      </list>
    </field>
  </record>

  <record id="upoferia_ticket_calendar_view" model="ir.ui.view">
    <field name="name">upoferia.ticket.calendar</field>
    <field name="model">upoferia.ticket</field>
    <field name="arch" type="xml">
      <calendar string="Tickets" color="tarifa_id" date_start="dtFecha" mode="week">
        <field name="sReferencia" />
        <field name="tarifa_id" />
      </calendar>
    </field>
  </record>

  <record id="upoferia_ticket_search_view" model="ir.ui.view">
    <field name="name">upoferia.ticket.search</field>
    <field name="model">upoferia.ticket</field>
    <field name="arch" type="xml">
      <search>
        <field name="sReferencia" />
        <field name="tarifa_id" />
        <separator orientation="vertical" />
        <group expand="0" string="Agrupar por...">
          <filter name="group_by_tarifa" string="Tarifa" context="{'group_by':'tarifa_id'}" />
          <filter name="group_by_fecha" string="Día" context="{'group_by':'dtFecha:day'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="ticket_list_action" model="ir.actions.act_window">
    <field name="name">Tickets</field>
    <field name="res_model">upoferia.ticket</field>
    <field name="search_view_id" ref="upoferia_ticket_search_view" />
    <field name="view_mode">list,form,calendar</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer ticket</p>
    </field>
  </record>
</odoo>
