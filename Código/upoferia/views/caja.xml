<odoo>
  <record id="upoferia_caja_form_view" model="ir.ui.view">
    <field name="name">upoferia.caja.form</field>
    <field name="model">upoferia.caja</field>
    <field name="arch" type="xml">
      <form string="Cajas">
        <sheet layout="auto">
          <group>
            <group>
              <field name="sNombre" placeholder="Caja barra principal" />
              <field name="sUbicacion" />
            </group>
            <group>
              <field name="bActiva" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_caja_list_view" model="ir.ui.view">
    <field name="name">upoferia.caja.list</field>
    <field name="model">upoferia.caja</field>
    <field name="arch" type="xml">
      <list string="Cajas">
        <field name="sNombre" />
        <field name="sUbicacion" />
        <field name="bActiva" />
      </list>
    </field>
  </record>

  <record id="upoferia_caja_kanban_view" model="ir.ui.view">
    <field name="name">upoferia.caja.kanban</field>
    <field name="model">upoferia.caja</field>
    <field name="arch" type="xml">
      <kanban string="Cajas">
        <templates>
          <t t-name="card">
            <field name="sNombre" class="fw-bold fs-5" />
            <field name="sUbicacion" />
            <field name="bActiva" />
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="caja_list_action" model="ir.actions.act_window">
    <field name="name">Cajas</field>
    <field name="res_model">upoferia.caja</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera caja</p>
    </field>
  </record>
</odoo>
