<odoo>

  <!-- Vistas de Fase de montaje -->
  <record id="upoferia_fase_montaje_list_view" model="ir.ui.view">
    <field name="name">upoferia.fase_montaje.list</field>
    <field name="model">upoferia.fase_montaje</field>
    <field name="arch" type="xml">
      <list string="Fases de montaje">
        <field name="plan_montaje_id"/>
        <field name="iSecuencia"/>
        <field name="sNombre"/>
      </list>
    </field>
  </record>

  <record id="upoferia_fase_montaje_form_view" model="ir.ui.view">
    <field name="name">upoferia.fase_montaje.form</field>
    <field name="model">upoferia.fase_montaje</field>
    <field name="arch" type="xml">
      <form string="Fase de montaje">
        <sheet>
          <group>
            <group string="Fase">
              <field name="plan_montaje_id"/>
              <field name="sNombre"/>
            </group>
            <group string="Detalle">
              <field name="iSecuencia"/>
              <field name="sDescripcion"/>
            </group>
          </group>
          <notebook>
            <page name="tareas" string="Tareas">
              <field name="tarea_montaje_ids">
                <list>
                  <field name="sNombre"/>
                  <field name="dFechaInicio"/>
                  <field name="dFechaLimite"/>
                  <field name="selPrioridad"/>
                  <field name="selEstado"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_fase_montaje_action" model="ir.actions.act_window">
    <field name="name">Fases de montaje</field>
    <field name="res_model">upoferia.fase_montaje</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera fase de montaje</p>
    </field>
  </record>

</odoo>
