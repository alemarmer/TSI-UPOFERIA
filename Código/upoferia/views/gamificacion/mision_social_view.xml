<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_gamificacion_mision_social_list_view" model="ir.ui.view">
        <field name="name">upoferia.gamificacion.mision_social.list</field>
        <field name="model">upoferia.gamificacion.mision_social</field>
        <field name="arch" type="xml">
            <list string="Misiones Sociales">
                <field name="mision_id"/>
                <field name="tipo_reto"/>
                <field name="contador_personas"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_gamificacion_mision_social_form_view" model="ir.ui.view">
        <field name="name">upoferia.gamificacion.mision_social.form</field>
        <field name="model">upoferia.gamificacion.mision_social</field>
        <field name="arch" type="xml">
            <form string="Misiones Sociales">
                <sheet>
                    <group>
                        <field name="mision_id"/>
                        <field name="tipo_reto"/>
                        <field name="contador_personas"/>
                    </group>
                </sheet>
            </form>     
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_gamificacion_mision_social_action" model="ir.actions.act_window">
        <field name="name">Misiones Sociales</field>
        <field name="res_model">upoferia.gamificacion.mision_social</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera misión para comenzar a gestionar la gamificación.
            </p>
        </field>
    </record>
</odoo>
