<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_gamificacion_clan_list_view" model="ir.ui.view">
        <field name="name">upoferia.gamificacion.clan.list</field>
        <field name="model">upoferia.gamificacion.clan</field>
        <field name="arch" type="xml">
            <list string="Clanes">
                <field name="nombre "/>
                <field name="fecha_creacion"/>
                <field name="experiencia_total"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_gamificacion_clan_form_view" model="ir.ui.view">
        <field name="name">upoferia.gamificacion.clan.form</field>
        <field name="model">upoferia.gamificacion.clan</field>
        <field name="arch" type="xml">
            <form string="Clanes">
                <sheet>
                    <group>
                        <field name="nombre "/>
                        <field name="fecha_creacion"/>
                        <field name="experiencia_total"/>
                    </group>
                </sheet>
            </form>     
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_gamificacion_clan_action" model="ir.actions.act_window">
        <field name="name">Clanes</field>
        <field name="res_model">upoferia.gamificacion.clan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer clan para comenzar a gestionar la gamificación.
            </p>
        </field>
    </record>
</odoo>
