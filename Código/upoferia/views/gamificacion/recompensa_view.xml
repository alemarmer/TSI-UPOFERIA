<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_gamificacion_recompensa_list_view" model="ir.ui.view">
        <field name="name">upoferia.gamificacion.recompensa.list</field>
        <field name="model">upoferia.gamificacion.recompensa</field>
        <field name="arch" type="xml">
            <list string="Recompensas">
                <field name="nombre"/>
                <field name="descripcion"/>
                <field name="nivel_requerido"/>
                <field name="registro_xp_ids"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_gamificacion_recompensa_form_view" model="ir.ui.view">
        <field name="name">upoferia.gamificacion.recompensa.form</field>
        <field name="model">upoferia.gamificacion.recompensa</field>
        <field name="arch" type="xml">
            <form string="Recompensas">
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="descripcion"/>
                        <field name="nivel_requerido"/>
                        <field name="registro_xp_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_gamificacion_recompensa_action" model="ir.actions.act_window">
        <field name="name">Recompensas</field>
        <field name="res_model">upoferia.gamificacion.recompensa</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera recompensa para comenzar a gestionar la gamificación.
            </p>
        </field>
    </record>
</odoo>
