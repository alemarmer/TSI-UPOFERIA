<odoo>
  <record id="upoferia_metodo_pago_form_view" model="ir.ui.view">
    <field name="name">upoferia.metodo_pago.form</field>
    <field name="model">upoferia.metodo_pago</field>
    <field name="arch" type="xml">
      <form string="Métodos de pago">
        <sheet layout="auto">
          <group>
            <group>
              <field name="sNombre" placeholder="Tarjeta" />
              <field name="fComisionPorcentaje" />
            </group>
            <group>
              <field name="bActivo" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_metodo_pago_list_view" model="ir.ui.view">
    <field name="name">upoferia.metodo_pago.list</field>
    <field name="model">upoferia.metodo_pago</field>
    <field name="arch" type="xml">
      <list string="Métodos de pago">
        <field name="sNombre" />
        <field name="fComisionPorcentaje" />
        <field name="bActivo" />
      </list>
    </field>
  </record>

  <record id="upoferia_metodo_pago_kanban_view" model="ir.ui.view">
    <field name="name">upoferia.metodo_pago.kanban</field>
    <field name="model">upoferia.metodo_pago</field>
    <field name="arch" type="xml">
      <kanban string="Métodos de pago">
        <templates>
          <t t-name="card">
            <field name="sNombre" class="fw-bold fs-5" />
            <field name="fComisionPorcentaje" />
            <field name="bActivo" />
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="metodo_pago_list_action" model="ir.actions.act_window">
    <field name="name">Métodos de pago</field>
    <field name="res_model">upoferia.metodo_pago</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer método de pago</p>
    </field>
  </record>
</odoo>
