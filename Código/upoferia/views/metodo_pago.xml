<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="metodo_pago_view_list" model="ir.ui.view">
        <field name="name">upoferia.metodo_pago.list</field>
        <field name="model">upoferia.metodo_pago</field>
        <field name="arch" type="xml">
            <list>
                <field name="sNombre"/>
                <field name="fComisionPorcentaje"/>
                <field name="bActivo"/>
            </list>
        </field>
    </record>

    <record id="metodo_pago_view_form" model="ir.ui.view">
        <field name="name">upoferia.metodo_pago.form</field>
        <field name="model">upoferia.metodo_pago</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sNombre" placeholder="Nombre"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fComisionPorcentaje"/>
                        </group>
                        <group>
                            <field name="bActivo"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="metodo_pago_view_kanban" model="ir.ui.view">
        <field name="name">upoferia.metodo_pago.kanban</field>
        <field name="model">upoferia.metodo_pago</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="sNombre" class="fw-bold fs-5"/>
                        <field name="fComisionPorcentaje"/>
                        <field name="bActivo"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="metodo_pago_list_action" model="ir.actions.act_window">
        <field name="name">Métodos de pago</field>
        <field name="res_model">upoferia.metodo_pago</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea el primer método de pago</p>
        </field>
    </record>

    <menuitem name="Métodos de pago" id="metodo_pago_menu" parent="catalogos_menu" action="metodo_pago_list_action" sequence="30"/>

</odoo>
