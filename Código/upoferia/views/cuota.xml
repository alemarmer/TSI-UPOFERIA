<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cuota_view_list" model="ir.ui.view">
        <field name="name">upoferia.cuota.list</field>
        <field name="model">upoferia.cuota</field>
        <field name="arch" type="xml">
            <list>
                <field name="sReferencia"/>
                <field name="iEjercicio"/>
                <field name="tipo_cuota_id"/>
                <field name="bonificacion_id"/>
                <field name="dFechaEmision"/>
                <field name="dFechaVencimiento"/>
                <field name="selPeriodicidad"/>
            </list>
        </field>
    </record>

    <record id="cuota_view_form" model="ir.ui.view">
        <field name="name">upoferia.cuota.form</field>
        <field name="model">upoferia.cuota</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sReferencia" placeholder="Referencia"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="iEjercicio"/>
                            <field name="dFechaEmision"/>
                            <field name="dFechaVencimiento"/>
                            <field name="selPeriodicidad"/>
                        </group>
                        <group>
                            <field name="tipo_cuota_id"/>
                            <field name="bonificacion_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movimientos">
                            <field name="movimiento_ids">
                                <list>
                                    <field name="sReferencia"/>
                                    <field name="dFecha"/>
                                    <field name="fImporte"/>
                                    <field name="selEstado"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cuota_view_calendar" model="ir.ui.view">
        <field name="name">upoferia.cuota.calendar</field>
        <field name="model">upoferia.cuota</field>
        <field name="arch" type="xml">
            <calendar string="Cuotas" date_start="dFechaEmision" date_stop="dFechaVencimiento" color="tipo_cuota_id" mode="month">
                <field name="sReferencia"/>
                <field name="tipo_cuota_id"/>
            </calendar>
        </field>
    </record>

    <record id="cuota_list_action" model="ir.actions.act_window">
        <field name="name">Cuotas</field>
        <field name="res_model">upoferia.cuota</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera cuota</p>
        </field>
    </record>

    <menuitem name="Cuotas" id="cuota_menu" parent="tesoreria_menu" action="cuota_list_action" sequence="20"/>

</odoo>
