<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="upoferia_turnos_fichajes_list_view" model="ir.ui.view">
        <field name="name">upoferia.turnos.fichaje.list</field>
        <field name="model">upoferia.turnos.fichaje</field>
        <field name="arch" type="xml">
            <list string="Fichajes">
                <field name="evento_puerta_num"/>
                <field name="fecha_turno"/>
                <field name="referencia_nomina"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="upoferia_turnos_fichajes_form_view" model="ir.ui.view">
        <field name="name">upoferia.turnos.fichaje.form</field>
        <field name="model">upoferia.turnos.fichaje</field>
        <field name="arch" type="xml">
            <form string="Fichajes">
                <sheet>
                    <group>
                        <field name="evento_puerta_num" readonly="1"/>
                        <field name="fecha_turno"/>
                        <field name="referencia_nomina"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Calendar -->
    <record id="upoferia_turnos_fichajes_calendar_view" model="ir.ui.view">
        <field name="name">upoferia.turnos.fichaje.calendar</field>
        <field name="model">upoferia.turnos.fichaje</field>
        <field name="arch" type="xml">
            <calendar string="Fichajes" date_start="fecha_turno" date_stop="fecha_turno">
            </calendar>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="upoferia_turnos_fichajes_action" model="ir.actions.act_window">
        <field name="name">Fichajes</field>
        <field name="res_model">upoferia.turnos.fichaje</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Comienza ha fichar para poder ver la lista.
            </p>
        </field>
    </record>
</odoo>