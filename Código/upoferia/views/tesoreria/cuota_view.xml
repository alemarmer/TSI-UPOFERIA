<odoo>
  <record id="upoferia_cuota_form_view" model="ir.ui.view">
    <field name="name">upoferia.cuota.form</field>
    <field name="model">upoferia.cuota</field>
    <field name="arch" type="xml">
      <form string="Cuotas">
        <sheet layout="auto">
          <group>
            <group>
              <field name="sReferencia" placeholder="CUO-2026-001" />
              <field name="iEjercicio" />
              <field name="tipo_cuota_id" />
              <field name="bonificacion_id" />
            </group>
            <group>
              <field name="dFechaEmision" />
              <field name="dFechaVencimiento" />
              <field name="selPeriodicidad" />
            </group>
          </group>
          <notebook>
            <page name="movimientos" string="Movimientos">
              <field name="movimiento_ids" readonly="1" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_cuota_list_view" model="ir.ui.view">
    <field name="name">upoferia.cuota.list</field>
    <field name="model">upoferia.cuota</field>
    <field name="arch" type="xml">
      <list string="Cuotas">
        <field name="sReferencia" />
        <field name="iEjercicio" />
        <field name="tipo_cuota_id" />
        <field name="bonificacion_id" />
        <field name="dFechaEmision" />
        <field name="dFechaVencimiento" />
        <field name="selPeriodicidad" />
      </list>
    </field>
  </record>

  <record id="upoferia_cuota_calendar_view" model="ir.ui.view">
    <field name="name">upoferia.cuota.calendar</field>
    <field name="model">upoferia.cuota</field>
    <field name="arch" type="xml">
      <calendar string="Cuotas" color="tipo_cuota_id" date_start="dFechaEmision" date_stop="dFechaVencimiento" mode="month">
        <field name="sReferencia" />
        <field name="tipo_cuota_id" />
      </calendar>
    </field>
  </record>

  <record id="upoferia_cuota_search_view" model="ir.ui.view">
    <field name="name">upoferia.cuota.search</field>
    <field name="model">upoferia.cuota</field>
    <field name="arch" type="xml">
      <search>
        <field name="sReferencia" />
        <field name="iEjercicio" />
        <field name="tipo_cuota_id" />
        <separator orientation="vertical" />
        <group expand="0" string="Agrupar por...">
          <filter name="group_by_ejercicio" string="Ejercicio" context="{'group_by':'iEjercicio'}" />
          <filter name="group_by_tipo" string="Tipo de cuota" context="{'group_by':'tipo_cuota_id'}" />
          <filter name="group_by_bonificacion" string="Bonificación" context="{'group_by':'bonificacion_id'}" />
          <filter name="group_by_periodicidad" string="Periodicidad" context="{'group_by':'selPeriodicidad'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="cuota_list_action" model="ir.actions.act_window">
    <field name="name">Cuotas</field>
    <field name="res_model">upoferia.cuota</field>
    <field name="search_view_id" ref="upoferia_cuota_search_view" />
    <field name="view_mode">list,form,calendar</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera cuota</p>
    </field>
  </record>
</odoo>
