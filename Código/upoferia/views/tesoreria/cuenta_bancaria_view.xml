<odoo>
  <record id="upoferia_cuenta_bancaria_form_view" model="ir.ui.view">
    <field name="name">upoferia.cuenta_bancaria.form</field>
    <field name="model">upoferia.cuenta_bancaria</field>
    <field name="arch" type="xml">
      <form string="Cuentas bancarias">
        <sheet layout="auto">
          <group>
            <group>
              <field name="sIban" placeholder="ES91 2100 0418 4502 0005 1332" />
              <field name="sBanco" />
              <field name="sTitular" />
            </group>
            <group>
              <field name="bActiva" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_cuenta_bancaria_list_view" model="ir.ui.view">
    <field name="name">upoferia.cuenta_bancaria.list</field>
    <field name="model">upoferia.cuenta_bancaria</field>
    <field name="arch" type="xml">
      <list string="Cuentas bancarias">
        <field name="sIban" />
        <field name="sBanco" />
        <field name="sTitular" />
        <field name="bActiva" />
      </list>
    </field>
  </record>

  <record id="upoferia_cuenta_bancaria_kanban_view" model="ir.ui.view">
    <field name="name">upoferia.cuenta_bancaria.kanban</field>
    <field name="model">upoferia.cuenta_bancaria</field>
    <field name="arch" type="xml">
      <kanban string="Cuentas bancarias">
        <templates>
          <t t-name="card">
            <field name="sIban" class="fw-bold fs-5" />
            <field name="sBanco" />
            <field name="sTitular" />
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="cuenta_bancaria_list_action" model="ir.actions.act_window">
    <field name="name">Cuentas bancarias</field>
    <field name="res_model">upoferia.cuenta_bancaria</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera cuenta bancaria</p>
    </field>
  </record>
</odoo>
