<odoo>
  <record id="upoferia_movimiento_form_view" model="ir.ui.view">
    <field name="name">upoferia.movimiento.form</field>
    <field name="model">upoferia.movimiento</field>
    <field name="arch" type="xml">
      <form string="Movimientos">
        <header>
          <field name="selEstado" widget="statusbar" options="{'clickable': '1'}" />
        </header>
        <sheet layout="auto">
          <group>
            <group>
              <field name="sReferencia" placeholder="MOV-2026-001" />
              <field name="dFecha" />
              <field name="selTipo" />
              <field name="fImporte" />
              <field name="sConcepto" />
              <field name="sPeriodo" />
            </group>
            <group>
              <field name="metodo_pago_id" />
              <field name="caja_id" />
              <field name="cuenta_bancaria_id" />
              <field name="categoria_economica_id" />
            </group>
          </group>
          <group>
            <field name="cuota_id" />
            <field name="ticket_id" />
            <field name="linea_presupuesto_id" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_movimiento_list_view" model="ir.ui.view">
    <field name="name">upoferia.movimiento.list</field>
    <field name="model">upoferia.movimiento</field>
    <field name="arch" type="xml">
      <list string="Movimientos">
        <field name="sReferencia" />
        <field name="dFecha" />
        <field name="selTipo" />
        <field name="sConcepto" />
        <field name="metodo_pago_id" />
        <field name="fImporte" sum="Total" />
        <field name="selEstado" />
      </list>
    </field>
  </record>

  <record id="upoferia_movimiento_calendar_view" model="ir.ui.view">
    <field name="name">upoferia.movimiento.calendar</field>
    <field name="model">upoferia.movimiento</field>
    <field name="arch" type="xml">
      <calendar string="Movimientos" color="metodo_pago_id" date_start="dFecha" mode="month">
        <field name="sReferencia" />
        <field name="selTipo" />
        <field name="fImporte" />
      </calendar>
    </field>
  </record>

  <record id="upoferia_movimiento_search_view" model="ir.ui.view">
    <field name="name">upoferia.movimiento.search</field>
    <field name="model">upoferia.movimiento</field>
    <field name="arch" type="xml">
      <search>
        <field name="sReferencia" />
        <field name="sConcepto" />
        <field name="metodo_pago_id" />
        <filter name="search_borradores" string="Borradores" domain="[('selEstado','=','borrador')]" />
        <filter name="search_confirmados" string="Confirmados" domain="[('selEstado','=','confirmado')]" />
        <filter name="search_anulados" string="Anulados" domain="[('selEstado','=','anulado')]" />
        <separator orientation="vertical" />
        <group expand="0" string="Agrupar por...">
          <filter name="group_by_tipo" string="Tipo" context="{'group_by':'selTipo'}" />
          <filter name="group_by_estado" string="Estado" context="{'group_by':'selEstado'}" />
          <filter name="group_by_metodo_pago" string="Método de pago" context="{'group_by':'metodo_pago_id'}" />
          <filter name="group_by_categoria" string="Categoría económica" context="{'group_by':'categoria_economica_id'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="movimiento_list_action" model="ir.actions.act_window">
    <field name="name">Movimientos</field>
    <field name="res_model">upoferia.movimiento</field>
    <field name="search_view_id" ref="upoferia_movimiento_search_view" />
    <field name="view_mode">list,form,calendar</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer movimiento</p>
    </field>
  </record>
</odoo>
