<odoo>
  <record id="upoferia_llave_form_view" model="ir.ui.view">
    <field name="name">upoferia.llave.form</field>
    <field name="model">upoferia.llave</field>
    <field name="arch" type="xml">
      <form string="Llaves">
        <sheet layout="auto">
          <group>
            <field name="sCodigoLlave" />
            <field name="sTipo" />
            <field name="sDescripcion" />
            <field name="numero" widget="many2one" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_llave_list_view" model="ir.ui.view">
    <field name="name">upoferia.llave.list</field>
    <field name="model">upoferia.llave</field>
    <field name="arch" type="xml">
      <list string="Llaves">
        <field name="sCodigoLlave" />
        <field name="sTipo" />
        <field name="sDescripcion" />
        <field name="numero" widget="many2one" />
      </list>
    </field>
  </record>

  <record id="llave_list_action" model="ir.actions.act_window">
    <field name="name">Llaves</field>
    <field name="res_model">upoferia.llave</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera llave</p>
    </field>
  </record>
</odoo>
