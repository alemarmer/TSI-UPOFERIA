<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="upoferia.IdentificacionAcceso">
        <div>
            <h2>Identificación de acceso</h2>

            <select t-model="state.puntoId" class="form-select w-auto mb-2">
                <option t-foreach="state.puntos" t-as="punto" t-key="punto.id" t-att-value="punto.id">
                    <t t-esc="punto.name"/>
                </option>
            </select>

            <video t-ref="video" autoplay="autoplay" playsinline="playsinline" muted="muted" style="width:640px; height:480px; background:black;"/>
            <canvas t-ref="canvas" class="d-none"/>

            <div t-if="state.error" class="text-danger">
                <t t-esc="state.error"/>
            </div>

            <div t-if="state.resultado"
                 class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                 style="background: rgba(0, 0, 0, 0.5); z-index: 1100;"
                 t-on-click="cerrarResultado">
                <div class="bg-white rounded shadow text-center p-5" style="min-width: 320px;">
                    <i t-if="state.resultado.ok" class="fa fa-check-circle text-success" style="font-size: 120px;"/>
                    <i t-else="" class="fa fa-times-circle text-danger" style="font-size: 120px;"/>
                    <t t-if="state.resultado.ok">
                        <h1 class="mt-3 mb-1"><t t-esc="state.resultado.tipo_movimiento"/></h1>
                        <h3 class="mb-3"><t t-esc="state.resultado.nombre_persona"/></h3>
                        <p class="fs-4 mb-0">
                            Aforo: <t t-esc="state.resultado.aforo_actual"/> / <t t-esc="state.resultado.aforo_maximo"/>
                        </p>
                    </t>
                    <t t-else="">
                        <h3 class="mt-3 mb-0 text-danger"><t t-esc="state.resultado.message"/></h3>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>