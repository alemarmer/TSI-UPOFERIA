<odoo>
  <record id="upoferia_bonificacion_form_view" model="ir.ui.view">
    <field name="name">upoferia.bonificacion.form</field>
    <field name="model">upoferia.bonificacion</field>
    <field name="arch" type="xml">
      <form string="Bonificaciones">
        <sheet layout="auto">
          <group>
            <field name="sNombre" placeholder="Socio de honor" />
            <field name="fPorcentajeDescuento" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoferia_bonificacion_list_view" model="ir.ui.view">
    <field name="name">upoferia.bonificacion.list</field>
    <field name="model">upoferia.bonificacion</field>
    <field name="arch" type="xml">
      <list string="Bonificaciones">
        <field name="sNombre" />
        <field name="fPorcentajeDescuento" />
      </list>
    </field>
  </record>

  <record id="upoferia_bonificacion_graph_view" model="ir.ui.view">
    <field name="name">upoferia.bonificacion.graph</field>
    <field name="model">upoferia.bonificacion</field>
    <field name="arch" type="xml">
      <graph string="Descuento por bonificación" type="bar">
        <field name="sNombre" />
        <field name="fPorcentajeDescuento" type="measure" />
      </graph>
    </field>
  </record>

  <record id="bonificacion_list_action" model="ir.actions.act_window">
    <field name="name">Bonificaciones</field>
    <field name="res_model">upoferia.bonificacion</field>
    <field name="view_mode">list,form,graph</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera bonificación</p>
    </field>
  </record>
</odoo>
