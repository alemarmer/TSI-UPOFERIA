        <mxCell id="t3" parent="1" style="text;html=1;fontSize=18;align=left;" value="&lt;u&gt;Subrayado&lt;/u&gt;: clave primaria · &lt;i&gt;cursiva&lt;/i&gt;*: clave ajena (debajo de cada tabla se indica a qué tabla apunta)" vertex="1">
          <mxGeometry height="40" width="2400" y="-95" as="geometry" />
        </mxCell>
        <mxCell id="n0_0" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;CABALLOS Y ENGANCHES&lt;/b&gt;&lt;br&gt;&lt;b&gt;CABALLO&lt;/b&gt; (&lt;u&gt;microchip&lt;/u&gt;, nombre, raza, sexo)&lt;br&gt;&lt;b&gt;CARRUAJE&lt;/b&gt; (&lt;u&gt;num_registro&lt;/u&gt;, modelo, plazas)&lt;br&gt;&lt;b&gt;SALIDA&lt;/b&gt; (&lt;i&gt;&lt;u&gt;num_registro_carruaje&lt;/u&gt;&lt;/i&gt;*, &lt;u&gt;fecha_hora_salida&lt;/u&gt;, fecha_hora_vuelta, num_pasajeros, estado, &lt;i&gt;id_transaccion&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;num_registro_carruaje → CARRUAJE&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;id_transaccion → TRANSACCION (puede ser nula) · única&lt;br&gt;&lt;b&gt;SALIDA_CABALLO&lt;/b&gt; (&lt;i&gt;&lt;u&gt;microchip_caballo&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;num_registro_carruaje&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;fecha_hora_salida&lt;/u&gt;&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;microchip_caballo → CABALLO&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;num_registro_carruaje, fecha_hora_salida → SALIDA" vertex="1">
          <mxGeometry height="212" width="1680" as="geometry" />
        </mxCell>
        <mxCell id="n0_1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;CONCURSOS&lt;/b&gt;&lt;br&gt;&lt;b&gt;CONCURSO&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre&lt;/u&gt;&lt;/i&gt;*, bases, fecha_resultado, estado)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre → EVENTO&lt;br&gt;&lt;b&gt;JURADO&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre_concurso&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;dni_miembro&lt;/u&gt;&lt;/i&gt;*, rol)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_concurso → CONCURSO&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;dni_miembro → PERSONA&lt;br&gt;&lt;b&gt;PARTICIPACION_CONCURSO&lt;/b&gt; (&lt;i&gt;&lt;u&gt;dni_socio&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;nombre_concurso&lt;/u&gt;&lt;/i&gt;*, fecha)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;dni_socio → SOCIO&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_concurso → CONCURSO&lt;br&gt;&lt;b&gt;PREMIO&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre_concurso&lt;/u&gt;&lt;/i&gt;*, &lt;u&gt;puesto&lt;/u&gt;, descripcion, importe, xp_otorgada)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_concurso → CONCURSO" vertex="1">
          <mxGeometry height="250" width="1680" y="252" as="geometry" />
        </mxCell>
        <mxCell id="n0_2" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;INSPECCIONES E INCIDENCIAS&lt;/b&gt;&lt;br&gt;&lt;b&gt;INCIDENCIA&lt;/b&gt; (&lt;u&gt;referencia&lt;/u&gt;, fecha, prioridad, estado, &lt;i&gt;numero_serie_mobiliario_caseta&lt;/i&gt;*, &lt;i&gt;codigo_servicio&lt;/i&gt;*, &lt;i&gt;referencia_inspeccion&lt;/i&gt;*, &lt;i&gt;numero_punto&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;numero_serie_mobiliario_caseta → MOBILIARIO_CASETA (puede ser nula)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;codigo_servicio → SERVICIO (puede ser nula)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;referencia_inspeccion, numero_punto → PUNTO_CONTROL (puede ser nula)&lt;br&gt;&lt;b&gt;INSPECCION&lt;/b&gt; (&lt;u&gt;referencia&lt;/u&gt;, tipo, organismo, fecha, resultado, documento, estado, &lt;i&gt;nombre_caseta&lt;/i&gt;*, &lt;i&gt;microchip_caballo&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_caseta → CASETA&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;microchip_caballo → CABALLO (puede ser nula)&lt;br&gt;&lt;b&gt;INSPECCION_INSPECTOR&lt;/b&gt; (&lt;i&gt;&lt;u&gt;dni_inspector&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;referencia_inspeccion&lt;/u&gt;&lt;/i&gt;*, rol)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;dni_inspector → INSPECTOR&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;referencia_inspeccion → INSPECCION&lt;br&gt;&lt;b&gt;INSPECTOR&lt;/b&gt; (&lt;i&gt;&lt;u&gt;dni&lt;/u&gt;&lt;/i&gt;*, numero_acreditacion, organismo, cargo)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;dni → PERSONA&lt;br&gt;&lt;b&gt;MANTENIMIENTO&lt;/b&gt; (&lt;u&gt;id_mantenimiento&lt;/u&gt;, asunto, tipo_mantenimiento, fecha_solicitud, fecha_programada, duracion_horas, estado, &lt;i&gt;id_transaccion&lt;/i&gt;*, &lt;i&gt;referencia_incidencia&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;id_transaccion → TRANSACCION (puede ser nula)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;referencia_incidencia → INCIDENCIA (puede ser nula)&lt;br&gt;&lt;b&gt;MANTENIMIENTO_TECNICO&lt;/b&gt; (&lt;i&gt;&lt;u&gt;id_mantenimiento&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;dni_tecnico&lt;/u&gt;&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;id_mantenimiento → MANTENIMIENTO&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;dni_tecnico → TECNICO&lt;br&gt;&lt;b&gt;PUNTO_CONTROL&lt;/b&gt; (&lt;i&gt;&lt;u&gt;referencia_inspeccion&lt;/u&gt;&lt;/i&gt;*, &lt;u&gt;numero_punto&lt;/u&gt;, descripcion, resultado, observaciones, &lt;i&gt;numero_serie_elemento_seguridad&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;referencia_inspeccion → INSPECCION&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;numero_serie_elemento_seguridad → ELEMENTO_SEGURIDAD (puede ser nula)" vertex="1">
          <mxGeometry height="516" width="1680" y="542" as="geometry" />
        </mxCell>
        <mxCell id="n0_3" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;PASE DE FERIA (GAMIFICACIÓN)&lt;/b&gt;&lt;br&gt;&lt;b&gt;CLAN&lt;/b&gt; (&lt;u&gt;nombre&lt;/u&gt;, fecha_creacion, &lt;i&gt;dni_lider&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;dni_lider → SOCIO (puede ser nula) · única&lt;br&gt;&lt;b&gt;CLAN_TEMPORADA&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre_clan&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;nombre_temporada_pase&lt;/u&gt;&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_clan → CLAN&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_temporada_pase → TEMPORADA_PASE&lt;br&gt;&lt;b&gt;MISION&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre_temporada_pase&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;dni_socio&lt;/u&gt;&lt;/i&gt;*, &lt;u&gt;titulo&lt;/u&gt;, fecha_max, exp_adquirida, decripcion)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_temporada_pase, dni_socio → REGISTRO_XP&lt;br&gt;&lt;b&gt;MISION_DESCUBRIMIENTO&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre_temporada_pase&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;dni_socio&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;titulo&lt;/u&gt;&lt;/i&gt;*, tipo_busqueda, arsenal)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_temporada_pase, dni_socio, titulo → MISION&lt;br&gt;&lt;b&gt;MISION_EVENTO&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre_temporada_pase&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;dni_socio&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;titulo&lt;/u&gt;&lt;/i&gt;*, tipo_evento, fecha)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_temporada_pase, dni_socio, titulo → MISION&lt;br&gt;&lt;b&gt;MISION_SOCIAL&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre_temporada_pase&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;dni_socio&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;titulo&lt;/u&gt;&lt;/i&gt;*, tipo_reto, contador_personas)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_temporada_pase, dni_socio, titulo → MISION&lt;br&gt;&lt;b&gt;RACHA&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre_temporada_pase&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;dni_socio&lt;/u&gt;&lt;/i&gt;*, multiplicador_exp, duracion)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_temporada_pase, dni_socio → REGISTRO_XP&lt;br&gt;&lt;b&gt;RECOMPENSA&lt;/b&gt; (&lt;u&gt;nombre&lt;/u&gt;, descripcion, nivel_requerido)&lt;br&gt;&lt;b&gt;RECOMPENSA_PENDIENTE&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre_temporada_pase&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;dni_socio&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;nombre_recompensa&lt;/u&gt;&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_temporada_pase, dni_socio → REGISTRO_XP&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_recompensa → RECOMPENSA&lt;br&gt;&lt;b&gt;REGISTRO_XP&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre_temporada_pase&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;dni_socio&lt;/u&gt;&lt;/i&gt;*, experiencia_acumulada, xp_ganada, &lt;i&gt;nombre_concurso&lt;/i&gt;*, &lt;i&gt;puesto_premio&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_temporada_pase → TEMPORADA_PASE&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;dni_socio → SOCIO&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_concurso, puesto_premio → PREMIO (puede ser nula)&lt;br&gt;&lt;b&gt;TEMPORADA_PASE&lt;/b&gt; (&lt;u&gt;nombre&lt;/u&gt;, fecha_inicio, fecha_fin)" vertex="1">
          <mxGeometry height="535" width="1680" y="1098" as="geometry" />
        </mxCell>
        <mxCell id="n0_4" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;PRESUPUESTO Y GASTOS&lt;/b&gt;&lt;br&gt;&lt;b&gt;CATEGORIA_ECONOMICA&lt;/b&gt; (&lt;u&gt;nombre&lt;/u&gt;, tipo)&lt;br&gt;&lt;b&gt;LINEA_PRESUPUESTO&lt;/b&gt; (&lt;i&gt;&lt;u&gt;ejercicio_presupuesto&lt;/u&gt;&lt;/i&gt;*, &lt;u&gt;concepto&lt;/u&gt;, tipo, importe_previsto, &lt;i&gt;nombre_categoria_economica&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;ejercicio_presupuesto → PRESUPUESTO&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_categoria_economica → CATEGORIA_ECONOMICA&lt;br&gt;&lt;b&gt;PRESUPUESTO&lt;/b&gt; (&lt;u&gt;ejercicio&lt;/u&gt;, nombre, fecha_inicio, fecha_fin, estado)" vertex="1">
          <mxGeometry height="155" width="1680" y="1673" as="geometry" />
        </mxCell>
        <mxCell id="n0_5" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;PRODUCTOS Y VENTAS EN BARRA&lt;/b&gt;&lt;br&gt;&lt;b&gt;LINEA_TICKET&lt;/b&gt; (&lt;i&gt;&lt;u&gt;referencia_ticket&lt;/u&gt;&lt;/i&gt;*, &lt;u&gt;numero_linea&lt;/u&gt;, cantidad, precio_unitario, &lt;i&gt;nombre_temporada_pase&lt;/i&gt;*, &lt;i&gt;dni_socio&lt;/i&gt;*, &lt;i&gt;codigo_interno_producto&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;referencia_ticket → TICKET&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_temporada_pase, dni_socio → REGISTRO_XP (puede ser nula)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;codigo_interno_producto → PRODUCTO&lt;br&gt;&lt;b&gt;PRODUCTO&lt;/b&gt; (&lt;u&gt;codigo_interno&lt;/u&gt;, alergenos, nombre, precio_socio, xp_otorgada, &lt;i&gt;nombre_tipo_producto&lt;/i&gt;*, &lt;i&gt;nombre_marca&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_tipo_producto → TIPO_PRODUCTO&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_marca → MARCA (puede ser nula)&lt;br&gt;&lt;b&gt;TARIFA&lt;/b&gt; (&lt;u&gt;nombre&lt;/u&gt;, moneda)&lt;br&gt;&lt;b&gt;TICKET&lt;/b&gt; (&lt;u&gt;referencia&lt;/u&gt;, fecha, &lt;i&gt;nombre_tarifa&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_tarifa → TARIFA&lt;br&gt;&lt;b&gt;TIPO_PRODUCTO&lt;/b&gt; (&lt;u&gt;nombre&lt;/u&gt;, &lt;i&gt;nombre_padre&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_padre → TIPO_PRODUCTO (puede ser nula)" vertex="1">
          <mxGeometry height="307" width="1680" y="1868" as="geometry" />
        </mxCell>
        <mxCell id="n1_0" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;CASETA E INSTALACIONES&lt;/b&gt;&lt;br&gt;&lt;b&gt;CASETA&lt;/b&gt; (&lt;u&gt;nombre&lt;/u&gt;, calle, numero, modulos, aforo_autorizado, hora_apertura, hora_cierre)&lt;br&gt;&lt;b&gt;COPIA_LLAVE&lt;/b&gt; (&lt;i&gt;&lt;u&gt;numero_taquilla&lt;/u&gt;&lt;/i&gt;*, &lt;i&gt;&lt;u&gt;fecha_inicio_asignacion_taquilla&lt;/u&gt;&lt;/i&gt;*, &lt;u&gt;numero_copia&lt;/u&gt;, fecha_baja, estado, fecha_entrega)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;numero_taquilla, fecha_inicio_asignacion_taquilla → ASIGNACION_TAQUILLA&lt;br&gt;&lt;b&gt;ELEMENTO_SEGURIDAD&lt;/b&gt; (&lt;i&gt;&lt;u&gt;numero_serie&lt;/u&gt;&lt;/i&gt;*, tipo, fecha_ultima_revision, fecha_proxima_revision)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;numero_serie → MOBILIARIO_CASETA&lt;br&gt;&lt;b&gt;LICENCIA&lt;/b&gt; (&lt;u&gt;numero_expediente&lt;/u&gt;, tipo, organismo, fecha_concesion, fecha_caducidad, estado, documento, &lt;i&gt;nombre_caseta&lt;/i&gt;*, &lt;i&gt;num_registro_carruaje&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_caseta → CASETA&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;num_registro_carruaje → CARRUAJE (puede ser nula)&lt;br&gt;&lt;b&gt;LLAVE&lt;/b&gt; (&lt;u&gt;codigo_llave&lt;/u&gt;, descripcion, tipo, &lt;i&gt;numero_taquilla&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;numero_taquilla → TAQUILLA (puede ser nula) · única&lt;br&gt;&lt;b&gt;MESA&lt;/b&gt; (&lt;u&gt;numero&lt;/u&gt;, capacidad, &lt;i&gt;nombre_caseta&lt;/i&gt;*, &lt;i&gt;nombre_zona_caseta&lt;/i&gt;*)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_caseta, nombre_zona_caseta → ZONA_CASETA (puede ser nula)&lt;br&gt;&lt;b&gt;MOBILIARIO_CASETA&lt;/b&gt; (&lt;u&gt;numero_serie&lt;/u&gt;, nombre, fecha_asignacion, coste)&lt;br&gt;&lt;b&gt;ZONA_CASETA&lt;/b&gt; (&lt;i&gt;&lt;u&gt;nombre_caseta&lt;/u&gt;&lt;/i&gt;*, &lt;u&gt;nombre&lt;/u&gt;, tipo, superficie_m2)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nombre_caseta → CASETA" vertex="1">
          <mxGeometry height="383" width="1680" x="1750" as="geometry" />
        </mxCell>
