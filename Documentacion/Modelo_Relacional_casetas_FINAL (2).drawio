        <mxCell id="subtitulo" parent="1" style="text;html=1;fontSize=24;align=left;verticalAlign=middle;fontColor=#404040;" value="Obtenido del modelo E-R final · 107 tablas · 147 claves ajenas" vertex="1">
          <mxGeometry height="40" width="2400" x="350" y="375" as="geometry" />
        </mxCell>
        <mxCell id="leyenda" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;strokeColor=#666666;fillColor=#ffffff;spacing=14;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#dae8fc&quot;&gt;&amp;nbsp;Azul&amp;nbsp;&lt;/span&gt; tabla de entidad · &lt;span style=&quot;background:#d5e8d4&quot;&gt;&amp;nbsp;Verde&amp;nbsp;&lt;/span&gt; entidad débil (clave = clave del dueño + discriminante) · &lt;span style=&quot;background:#e1d5e7&quot;&gt;&amp;nbsp;Lila&amp;nbsp;&lt;/span&gt; subtipo (su clave es la del supertipo) · &lt;span style=&quot;background:#fff2cc&quot;&gt;&amp;nbsp;Amarillo&amp;nbsp;&lt;/span&gt; tabla de relación N:M · &lt;span style=&quot;background:#f8cecc&quot;&gt;&amp;nbsp;Rosa&amp;nbsp;&lt;/span&gt; atributo multivaluado&lt;br&gt;PK: clave primaria (&lt;u&gt;subrayada&lt;/u&gt;) · FK: clave ajena (&lt;i&gt;cursiva&lt;/i&gt;) · NULL / NOT NULL: si la clave ajena es opcional · UNIQUE: relación 1:1&lt;br&gt;Pata de gallo: lado «muchos» · Barra: obligatorio (1) · Círculo: opcional (0) · &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;Líneas rojas&lt;/b&gt;&lt;/font&gt;: claves ajenas entre bloques distintos&lt;br&gt;Los atributos derivados del E-R no se guardan (se calculan) y los compuestos se descomponen en sus columnas." vertex="1">
          <mxGeometry height="190" width="1700" x="8332" y="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
