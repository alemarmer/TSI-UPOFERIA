        <mxCell id="tr14" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;PRODUCTOS Y VENTAS EN BARRA&lt;/b&gt;&lt;br&gt;&lt;b&gt;LINEA_TICKET&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;LineaTicket&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK referencia_ticket → TICKET: &lt;b&gt;composición&lt;/b&gt; Ticket 1 ◆— 1..* LineaTicket&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_temporada_pase, dni_socio → REGISTRO_XP: asociación LineaTicket * — 0..1 RegistroXp, rol &lt;i&gt;registroXp&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK codigo_interno_producto → PRODUCTO: asociación LineaTicket * — 1 Producto, rol &lt;i&gt;producto&lt;/i&gt;&lt;br&gt;&lt;b&gt;PRODUCTO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Producto&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_tipo_producto → TIPO_PRODUCTO: asociación Producto * — 1 TipoProducto, rol &lt;i&gt;tipoProducto&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_marca → MARCA: asociación Producto * — 0..1 Marca, rol &lt;i&gt;marca&lt;/i&gt;&lt;br&gt;&lt;b&gt;TARIFA&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Tarifa&lt;/b&gt;&lt;br&gt;&lt;b&gt;TICKET&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Ticket&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_tarifa → TARIFA: asociación Ticket * — 1 Tarifa, rol &lt;i&gt;tarifa&lt;/i&gt;&lt;br&gt;&lt;b&gt;TIPO_PRODUCTO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;TipoProducto&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_padre → TIPO_PRODUCTO: asociación TipoProducto * — 0..1 TipoProducto, rol &lt;i&gt;padre&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="3500" y="2154" width="1680" height="368" as="geometry" />
