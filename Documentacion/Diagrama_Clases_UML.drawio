        <mxCell id="titulo" parent="1" style="text;html=1;fontSize=44;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F3864;" value="DIAGRAMA DE CLASES UML – MÓDULO ODOO DE GESTIÓN INTEGRAL DE CASETAS DE FERIA" vertex="1">
