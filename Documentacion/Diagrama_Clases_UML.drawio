        </mxCell>
        <mxCell id="tr7" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;MATERIAL Y PRÉSTAMOS&lt;/b&gt;&lt;br&gt;&lt;b&gt;CATEGORIA_MATERIAL&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;CategoriaMaterial&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_padre → CATEGORIA_MATERIAL: asociación CategoriaMaterial * — 0..1 CategoriaMaterial, rol &lt;i&gt;padre&lt;/i&gt;&lt;br&gt;&lt;b&gt;MATERIAL&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Material&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_categoria_material → CATEGORIA_MATERIAL: asociación Material * — 1 CategoriaMaterial, rol &lt;i&gt;categoriaMaterial&lt;/i&gt;&lt;br&gt;&lt;b&gt;PRESTAMO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Prestamo&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK dni_proveedor → PROVEEDOR: asociación Prestamo * — 0..1 Proveedor, rol &lt;i&gt;proveedor&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK id_transaccion → TRANSACCION: asociación Prestamo * — 0..1 Transaccion, rol &lt;i&gt;transaccion&lt;/i&gt;&lt;br&gt;&lt;b&gt;PRESTAMO_LINEA&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;PrestamoLinea&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK referencia_prestamo → PRESTAMO: &lt;b&gt;composición&lt;/b&gt; Prestamo 1 ◆— 1..* PrestamoLinea&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK codigo_interno_material → MATERIAL: asociación PrestamoLinea * — 1 Material, rol &lt;i&gt;material&lt;/i&gt; (segundo propietario de la clave: asociación obligatoria)&lt;br&gt;&lt;b&gt;USO_MATERIAL&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;UsoMaterial&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK codigo_interno_material → MATERIAL: &lt;b&gt;composición&lt;/b&gt; Material 1 ◆— * UsoMaterial&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_plan_montaje, nombre_fase_montaje, nombre_tarea_montaje → TAREA_MONTAJE: asociación UsoMaterial * — 1 TareaMontaje, rol &lt;i&gt;tareaMontaje&lt;/i&gt; (segundo propietario de la clave: asociación obligatoria)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="3500" y="740" width="1680" height="387" as="geometry" />
        </mxCell>
        <mxCell id="tr8" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;MONTAJE&lt;/b&gt;&lt;br&gt;&lt;b&gt;CUADRILLA&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Cuadrilla&lt;/b&gt;&lt;br&gt;&lt;b&gt;CUADRILLA_EMPLEADO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Tabla N:M con atributos propios (es_jefe) → &lt;b&gt;clase de asociación CuadrillaEmpleado&lt;/b&gt; sobre la asociación Empleado * — * Cuadrilla «incluye»&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK dni_empleado → EMPLEADO: extremo de la asociación&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_cuadrilla → CUADRILLA: extremo de la asociación&lt;br&gt;&lt;b&gt;FASE_MONTAJE&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;FaseMontaje&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_plan_montaje → PLAN_MONTAJE: &lt;b&gt;composición&lt;/b&gt; PlanMontaje 1 ◆— * FaseMontaje&lt;br&gt;&lt;b&gt;PLAN_MONTAJE&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;PlanMontaje&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_caseta, nombre_zona_caseta → ZONA_CASETA: asociación PlanMontaje * — 0..1 ZonaCaseta, rol &lt;i&gt;zonaCaseta&lt;/i&gt;&lt;br&gt;&lt;b&gt;TAREA_MONTAJE&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;TareaMontaje&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_plan_montaje, nombre_fase_montaje → FASE_MONTAJE: &lt;b&gt;composición&lt;/b&gt; FaseMontaje 1 ◆— * TareaMontaje&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_cuadrilla → CUADRILLA: asociación TareaMontaje * — 0..1 Cuadrilla, rol &lt;i&gt;cuadrilla&lt;/i&gt;&lt;br&gt;&lt;b&gt;TRANSPORTE&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Transporte&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_plan_montaje, nombre_fase_montaje, nombre_tarea_montaje → TAREA_MONTAJE: asociación Transporte * — 0..1 TareaMontaje, rol &lt;i&gt;tareaMontaje&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" vertex="1" parent="1">
