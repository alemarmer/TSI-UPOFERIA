        <mxCell id="note_persona" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;Generalización de Persona&lt;/b&gt;&lt;br&gt;{incomplete, overlapping}&lt;br&gt;Parcial y solapada: una persona puede no ser de ningún subtipo o ser de varios a la vez." vertex="1">
