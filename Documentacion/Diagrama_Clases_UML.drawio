        </mxCell>
        <mxCell id="subtitulo" parent="1" style="text;html=1;fontSize=24;align=left;verticalAlign=middle;fontColor=#404040;" value="Obtenido del modelo E-R y del modelo relacional · 97 clases (6 de asociación) · 131 relaciones · tipos primitivos neutros de UML (Integer, Decimal, Boolean, String, Date, DateTime, Time)" vertex="1">
          <mxGeometry height="40" width="2800" x="350" y="445" as="geometry" />
        </mxCell>
        <mxCell id="leyenda" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;strokeColor=#666666;fillColor=#ffffff;spacing=14;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#dae8fc&quot;&gt;&amp;nbsp;Azul&amp;nbsp;&lt;/span&gt; clase (entidad) · &lt;span style=&quot;background:#d5e8d4&quot;&gt;&amp;nbsp;Verde&amp;nbsp;&lt;/span&gt; clase parte de una composición (entidad débil) · &lt;span style=&quot;background:#e1d5e7&quot;&gt;&amp;nbsp;Lila&amp;nbsp;&lt;/span&gt; subclase · &lt;span style=&quot;background:#fff2cc&quot;&gt;&amp;nbsp;Amarillo&amp;nbsp;&lt;/span&gt; clase de asociación (N:M con atributos)&lt;br&gt;Rombo negro ◆: composición (el todo en el lado del rombo) · Triángulo hueco ◁: herencia · Línea discontinua dorada: une la clase de asociación con su asociación&lt;br&gt;En cada extremo: multiplicidad y, en el extremo referenciado, el rol &lt;i&gt;-rol&lt;/i&gt; que sustituye a la clave ajena · «nombre»: relación N:M del E-R&lt;br&gt;{id}: identificador (clave primaria o discriminante) · /atributo: atributo derivado del E-R (se calcula) · &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;Líneas rojas&lt;/b&gt;&lt;/font&gt;: relaciones entre bloques distintos&lt;br&gt;Las claves ajenas no aparecen como atributos: están representadas por las relaciones." vertex="1">
          <mxGeometry height="200" width="1750" x="8208" y="340" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="traza" name="Trazabilidad tablas → UML">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="TRAZABILIDAD: CADA TABLA Y CADA CLAVE AJENA DEL MODELO RELACIONAL EN EL DIAGRAMA DE CLASES" style="text;html=1;fontSize=32;fontStyle=1;align=left;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="0" y="-140" width="2600" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tr0" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;CABALLOS Y ENGANCHES&lt;/b&gt;&lt;br&gt;&lt;b&gt;CABALLO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Caballo&lt;/b&gt;&lt;br&gt;&lt;b&gt;CARRUAJE&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Carruaje&lt;/b&gt;&lt;br&gt;&lt;b&gt;SALIDA&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;Salida&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK num_registro_carruaje → CARRUAJE: &lt;b&gt;composición&lt;/b&gt; Carruaje 1 ◆— * Salida&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK id_transaccion → TRANSACCION: asociación Salida 0..1 — 0..1 Transaccion, rol &lt;i&gt;transaccion&lt;/i&gt;&lt;br&gt;&lt;b&gt;SALIDA_CABALLO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Tabla N:M solo con FK → asociación directa Caballo * — * Salida «tira de» (desaparece como clase)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK microchip_caballo → CABALLO: extremo de la asociación&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK num_registro_carruaje, fecha_hora_salida → SALIDA: extremo de la asociación" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1680" height="273" as="geometry" />
        </mxCell>
        <mxCell id="tr1" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;CASETA E INSTALACIONES&lt;/b&gt;&lt;br&gt;&lt;b&gt;CASETA&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Caseta&lt;/b&gt;&lt;br&gt;&lt;b&gt;COPIA_LLAVE&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;CopiaLlave&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK numero_taquilla, fecha_inicio_asignacion_taquilla → ASIGNACION_TAQUILLA: &lt;b&gt;composición&lt;/b&gt; AsignacionTaquilla 1 ◆— * CopiaLlave&lt;br&gt;&lt;b&gt;ELEMENTO_SEGURIDAD&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Subtipo → clase &lt;b&gt;ElementoSeguridad&lt;/b&gt; (herencia)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK numero_serie → MOBILIARIO_CASETA: &lt;b&gt;herencia&lt;/b&gt; MobiliarioCaseta ◁— ElementoSeguridad&lt;br&gt;&lt;b&gt;LICENCIA&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Licencia&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_caseta → CASETA: asociación Licencia * — 1 Caseta, rol &lt;i&gt;caseta&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK num_registro_carruaje → CARRUAJE: asociación Licencia * — 0..1 Carruaje, rol &lt;i&gt;carruaje&lt;/i&gt;&lt;br&gt;&lt;b&gt;LLAVE&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Llave&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK numero_taquilla → TAQUILLA: asociación Llave 0..1 — 0..1 Taquilla, rol &lt;i&gt;taquilla&lt;/i&gt;&lt;br&gt;&lt;b&gt;MESA&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Mesa&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_caseta, nombre_zona_caseta → ZONA_CASETA: asociación Mesa * — 0..1 ZonaCaseta, rol &lt;i&gt;zonaCaseta&lt;/i&gt;&lt;br&gt;&lt;b&gt;MOBILIARIO_CASETA&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;MobiliarioCaseta&lt;/b&gt;&lt;br&gt;&lt;b&gt;ZONA_CASETA&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;ZonaCaseta&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_caseta → CASETA: &lt;b&gt;composición&lt;/b&gt; Caseta 1 ◆— * ZonaCaseta" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1750" y="0" width="1680" height="482" as="geometry" />
        </mxCell>
        <mxCell id="tr2" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;COMPRAS A PROVEEDORES&lt;/b&gt;&lt;br&gt;&lt;b&gt;LINEA_TRANSACCION&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;LineaTransaccion&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK id_transaccion → TRANSACCION: &lt;b&gt;composición&lt;/b&gt; Transaccion 1 ◆— * LineaTransaccion&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK id_transaccion_pedido, numero_linea_pedido → LINEA_TRANSACCION: asociación LineaTransaccion * — 0..1 LineaTransaccion, rol &lt;i&gt;lineaPedido&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK codigo_interno_producto → PRODUCTO: asociación LineaTransaccion * — 0..1 Producto, rol &lt;i&gt;producto&lt;/i&gt;&lt;br&gt;&lt;b&gt;TIPO_TRANSACCION&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;TipoTransaccion&lt;/b&gt;&lt;br&gt;&lt;b&gt;TRANSACCION&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;Transaccion&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK codigo_tipo_transaccion → TIPO_TRANSACCION: asociación Transaccion * — 1 TipoTransaccion, rol &lt;i&gt;tipoTransaccion&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK id_transaccion_origen → TRANSACCION: asociación Transaccion * — 0..1 Transaccion, rol &lt;i&gt;transaccionOrigen&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK dni_proveedor → PROVEEDOR: asociación Transaccion * — 1 Proveedor, rol &lt;i&gt;proveedor&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_caseta → CASETA: asociación Transaccion * — 0..1 Caseta, rol &lt;i&gt;caseta&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK ejercicio_presupuesto, concepto_linea_presupuesto → LINEA_PRESUPUESTO: asociación Transaccion * — 0..1 LineaPresupuesto, rol &lt;i&gt;lineaPresupuesto&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="3500" y="0" width="1680" height="311" as="geometry" />
        </mxCell>
        <mxCell id="tr3" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;CONCURSOS&lt;/b&gt;&lt;br&gt;&lt;b&gt;CONCURSO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Subtipo → clase &lt;b&gt;Concurso&lt;/b&gt; (herencia)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre → EVENTO: &lt;b&gt;herencia&lt;/b&gt; Evento ◁— Concurso&lt;br&gt;&lt;b&gt;JURADO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;Jurado&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_concurso → CONCURSO: &lt;b&gt;composición&lt;/b&gt; Concurso 1 ◆— 1..* Jurado&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK dni_miembro → PERSONA: asociación Jurado * — 1 Persona, rol &lt;i&gt;miembro&lt;/i&gt; (segundo propietario de la clave: asociación obligatoria)&lt;br&gt;&lt;b&gt;PARTICIPACION_CONCURSO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Tabla N:M con atributos propios (fecha) → &lt;b&gt;clase de asociación ParticipacionConcurso&lt;/b&gt; sobre la asociación Socio * — * Concurso «participa»&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK dni_socio → SOCIO: extremo de la asociación&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_concurso → CONCURSO: extremo de la asociación&lt;br&gt;&lt;b&gt;PREMIO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;Premio&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_concurso → CONCURSO: &lt;b&gt;composición&lt;/b&gt; Concurso 1 ◆— * Premio" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="0" y="313" width="1680" height="311" as="geometry" />
        </mxCell>
        <mxCell id="tr4" value="&lt;b style=&quot;font-size:17px;color:#1F3864&quot;&gt;CONTROL DE ACCESOS (PUERTA)&lt;/b&gt;&lt;br&gt;&lt;b&gt;CONTROL_AFORO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Subtipo → clase &lt;b&gt;ControlAforo&lt;/b&gt; (herencia)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK id_evento_puerta → EVENTO_PUERTA: &lt;b&gt;herencia&lt;/b&gt; EventoPuerta ◁— ControlAforo&lt;br&gt;&lt;b&gt;EVENTO_PUERTA&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;EventoPuerta&lt;/b&gt;&lt;br&gt;&lt;b&gt;INCIDENCIA_PUERTA&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Subtipo → clase &lt;b&gt;IncidenciaPuerta&lt;/b&gt; (herencia)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK id_evento_puerta → EVENTO_PUERTA: &lt;b&gt;herencia&lt;/b&gt; EventoPuerta ◁— IncidenciaPuerta&lt;br&gt;&lt;b&gt;PUNTO_ACCESO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad → clase &lt;b&gt;PuntoAcceso&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_caseta, nombre_zona_caseta → ZONA_CASETA: asociación PuntoAcceso * — 0..1 ZonaCaseta, rol &lt;i&gt;zonaCaseta&lt;/i&gt;&lt;br&gt;&lt;b&gt;REGISTRO_ACCESO&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Entidad débil → clase &lt;b&gt;RegistroAcceso&lt;/b&gt; (parte de una composición)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK nombre_entrada_punto_acceso → PUNTO_ACCESO: &lt;b&gt;composición&lt;/b&gt; PuntoAcceso 1 ◆— * RegistroAcceso&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK dni_persona → PERSONA: asociación RegistroAcceso * — 0..1 Persona, rol &lt;i&gt;persona&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;FK id_evento_puerta → EVENTO_PUERTA: asociación RegistroAcceso 0..1 — 1 EventoPuerta, rol &lt;i&gt;eventoPuerta&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;fillColor=#ffffff;spacing=12;" vertex="1" parent="1">
